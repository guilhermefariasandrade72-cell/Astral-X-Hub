-- 🔍 Verificação de Estado do Jogador e Definição de Cor
local function ObterEstadoJogador(p)
    local char = p.Character
    if not char then return Color3.fromRGB(255, 255, 255) end

    -- 🔴 Vermelho: Segurando qualquer item/ferramenta na mão
    local ferramenta = char:FindFirstChildOfClass("Tool")
    if ferramenta then
        return Color3.fromRGB(255, 50, 50)
    end

    -- 🟢 Verde: Na partida sem item | ⚪ Branco: No Lobby
    if p:GetAttribute("Alive") == true then
        return Color3.fromRGB(50, 255, 100)
    else
        return Color3.fromRGB(255, 255, 255)
    end
end

-- 🔴 Função para Criar/Atualizar Highlight
local function CriarHighlight(Alvo, Cor)
    if not Alvo then return end
    if not Highlights[Alvo] then
        local H = Instance.new("Highlight")
        H.Name = "ESP_Highlight"
        H.Adornee = Alvo
        H.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        H.OutlineTransparency = 0
        H.FillTransparency = 0.5
        H.Parent = Alvo
        Highlights[Alvo] = H
    end
    Highlights[Alvo].FillColor = Cor
    Highlights[Alvo].OutlineColor = Cor
    Highlights[Alvo].Enabled = true
end

-- 🟢 Função para Criar/Atualizar Nome (Em cima da cabeça)
local function CriarNomeESP(Jogador, Cor)
    local Char = Jogador.Character
    if not Char or not Char:FindFirstChild("Head") then return end
    local Head = Char.Head

    if not NamesESP[Jogador] or not NamesESP[Jogador].Gui or NamesESP[Jogador].Gui.Parent ~= Head then
        if NamesESP[Jogador] and NamesESP[Jogador].Gui then NamesESP[Jogador].Gui:Destroy() end
        
        local BGui = Instance.new("BillboardGui")
        BGui.Name = "ESP_Name"
        BGui.Adornee = Head
        BGui.Size = UDim2.new(0, 150, 0, 30)
        BGui.StudsOffset = Vector3.new(0, 2.2, 0)
        BGui.AlwaysOnTop = true

        local TextLabel = Instance.new("TextLabel")
        TextLabel.Name = "Label"
        TextLabel.Size = UDim2.new(1, 0, 1, 0)
        TextLabel.BackgroundTransparency = 1
        TextLabel.Font = Enum.Font.SourceSansBold
        TextLabel.TextSize = 14
        TextLabel.TextStrokeTransparency = 0
        TextLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        TextLabel.Parent = BGui

        BGui.Parent = Head
        NamesESP[Jogador] = {Gui = BGui, Label = TextLabel}
    end

    local Data = NamesESP[Jogador]
    Data.Label.Text = Jogador.Name
    Data.Label.TextColor3 = Cor
    Data.Gui.Enabled = true
end

-- 🔵 Função para Criar/Atualizar Distância (Embaixo dos pés)
local function CriarDistanciaESP(Jogador, Cor, Distancia)
    local Char = Jogador.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then return end
    local HRP = Char.HumanoidRootPart

    if not DistanceESP[Jogador] or not DistanceESP[Jogador].Gui or DistanceESP[Jogador].Gui.Parent ~= HRP then
        if DistanceESP[Jogador] and DistanceESP[Jogador].Gui then DistanceESP[Jogador].Gui:Destroy() end

        local BGui = Instance.new("BillboardGui")
        BGui.Name = "ESP_Distance"
        BGui.Adornee = HRP
        BGui.Size = UDim2.new(0, 100, 0, 20)
        BGui.StudsOffset = Vector3.new(0, -3.2, 0)
        BGui.AlwaysOnTop = true

        local TextLabel = Instance.new("TextLabel")
        TextLabel.Name = "Label"
        TextLabel.Size = UDim2.new(1, 0, 1, 0)
        TextLabel.BackgroundTransparency = 1
        TextLabel.Font = Enum.Font.SourceSansBold
        TextLabel.TextSize = 13
        TextLabel.TextStrokeTransparency = 0
        TextLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        TextLabel.Parent = BGui

        BGui.Parent = HRP
        DistanceESP[Jogador] = {Gui = BGui, Label = TextLabel}
    end

    local Data = DistanceESP[Jogador]
    Data.Label.Text = math.floor(Distancia) .. "m"
    Data.Label.TextColor3 = Cor
    Data.Gui.Enabled = true
end

-- 🟡 Função para Criar/Atualizar Linha (Tracer saindo de baixo da tela)
local function CriarTracerESP(Jogador, Cor)
    local Char = Jogador.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then return end
    local Cam = Workspace.CurrentCamera
    
    local Vector, OnScreen = Cam:WorldToViewportPoint(Char.HumanoidRootPart.Position)

    if not TracersESP[Jogador] then
        local Line = Drawing.new("Line")
        Line.Thickness = 1.5
        Line.Transparency = 1
        TracersESP[Jogador] = Line
    end

    local Line = TracersESP[Jogador]
    if OnScreen then
        Line.From = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y)
        Line.To = Vector2.new(Vector.X, Vector.Y)
        Line.Color = Cor
        Line.Visible = true
    else
        Line.Visible = false
    end
end

-- 🧹 Limpeza Individual de Jogador
local function LimparJogadorESP(p)
    if Highlights[p.Character] then
        Highlights[p.Character]:Destroy()
        Highlights[p.Character] = nil
    end
    if NamesESP[p] then
        if NamesESP[p].Gui then NamesESP[p].Gui:Destroy() end
        NamesESP[p] = nil
    end
    if DistanceESP[p] then
        if DistanceESP[p].Gui then DistanceESP[p].Gui:Destroy() end
        DistanceESP[p] = nil
    end
    if TracersESP[p] then
        TracersESP[p].Visible = false
        TracersESP[p]:Remove()
        TracersESP[p] = nil
    end
end

-- 🧹 Limpeza Geral de Tabelas
local function LimparTabela(Tabela)
    for _, item in pairs(Tabela) do
        if typeof(item) == "Instance" then
            item:Destroy()
        elseif type(item) == "table" and item.Gui then
            item.Gui:Destroy()
        elseif type(item) == "userdata" and item.Remove then
            item:Remove()
        end
    end
    table.clear(Tabela)
end

-- 🔄 Loop Principal do ESP (RenderStepped)
RunService.RenderStepped:Connect(function()
    if ESPHighlightAtivo or ESPNomeAtivo or ESPDistanciaAtiva or ESPTracerAtivo then
        local MeuChar = player.Character
        local MinhaPos = (MeuChar and MeuChar:FindFirstChild("HumanoidRootPart")) and MeuChar.HumanoidRootPart.Position or Vector3.new(0,0,0)

        for _, p in ipairs(Players:GetPlayers()) do
            local Char = p.Character
            local Humanoid = Char and Char:FindFirstChildOfClass("Humanoid")
            local HRP = Char and Char:FindFirstChild("HumanoidRootPart")

            if p == player or not Char or not HRP or not Humanoid or Humanoid.Health <= 0 then
                LimparJogadorESP(p)
            else
                local Cor = ObterEstadoJogador(p)
                local Distancia = (MinhaPos - HRP.Position).Magnitude

                if ESPHighlightAtivo then CriarHighlight(Char, Cor) elseif Highlights[Char] then Highlights[Char].Enabled = false end
                if ESPNomeAtivo then CriarNomeESP(p, Cor) elseif NamesESP[p] and NamesESP[p].Gui then NamesESP[p].Gui.Enabled = false end
                if ESPDistanciaAtiva then CriarDistanciaESP(p, Cor, Distancia) elseif DistanceESP[p] and DistanceESP[p].Gui then DistanceESP[p].Gui.Enabled = false end
                if ESPTracerAtivo then CriarTracerESP(p, Cor) elseif TracersESP[p] then TracersESP[p].Visible = false end
            end
        end
    else
        if next(Highlights) then LimparTabela(Highlights) end
        if next(NamesESP) then LimparTabela(NamesESP) end
        if next(DistanceESP) then LimparTabela(DistanceESP) end
        if next(TracersESP) then LimparTabela(TracersESP) end
    end
end)


