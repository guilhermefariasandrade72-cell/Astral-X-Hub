-- 🎯 Função para encontrar o jogador mais próximo da mira/centro da tela
local function ObterJogadorMaisProximo()
    local Cam = Workspace.CurrentCamera
    local CentroTela = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
    local AlvoMaisProximo = nil
    local MenorDistancia = RadioFOV -- Limita a busca apenas a quem estiver dentro do raio do FOV

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("Head") then
            local Head = p.Character.Head
            local Humanoid = p.Character:FindFirstChildOfClass("Humanoid")

            if Humanoid and Humanoid.Health > 0 then
                local Vector, OnScreen = Cam:WorldToViewportPoint(Head.Position)

                if OnScreen then
                    local PosicaoTela = Vector2.new(Vector.X, Vector.Y)
                    local DistanciaDaMira = (PosicaoTela - CentroTela).Magnitude

                    if DistanciaDaMira < MenorDistancia then
                        MenorDistancia = DistanciaDaMira
                        AlvoMaisProximo = Head
                    end
                end
            end
        end
    end

    return AlvoMaisProximo
end

-- ⭕ Função para Criar / Atualizar o Círculo de FOV na Tela
local function AtualizarCircleFOV()
    if not FOVCircle then
        FOVCircle = Drawing.new("Circle")
        FOVCircle.Color = Color3.fromRGB(255, 255, 255) -- Cor Branca
        FOVCircle.Thickness = 1.5
        FOVCircle.NumSides = 64
        FOVCircle.Filled = false
        FOVCircle.Transparency = 1
    end

    if CircleFOVAtivo then
        local Cam = Workspace.CurrentCamera
        FOVCircle.Position = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
        FOVCircle.Radius = RadioFOV
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end
end

-- 🔄 Loop Principal em RenderStepped (Atualização Instantânea)
RunService.RenderStepped:Connect(function()
    -- Atualiza o Círculo Enfeite
    AtualizarCircleFOV()

    -- Atualiza o Aimbot grudando no jogador mais próximo
    if AimbotAtivo then
        local Alvo = ObterJogadorMaisProximo()
        if Alvo then
            local Cam = Workspace.CurrentCamera
            Cam.CFrame = CFrame.new(Cam.CFrame.Position, Alvo.Position)
        end
    end
end)

