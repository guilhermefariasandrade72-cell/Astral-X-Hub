local function PegarHoras()
    local Tempo = os.date("*t")
    return string.format("%02d:%02d", Tempo.hour, Tempo.min)
end

local function CriarTexto(Ordem, Titulo, Valor)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, -20, 0, 20)
    Container.Position = UDim2.new(0, 10, 0, 120 + (Ordem - 1) * 28)
    Container.BackgroundTransparency = 1
    Container.Parent = Janela

    local Texto = Instance.new("TextLabel")
    Texto.Size = UDim2.new(1, 0, 1, 0)
    Texto.BackgroundTransparency = 1
    Texto.Text = Titulo .. ": " .. Valor
    Texto.TextColor3 = Color3.fromRGB(230, 230, 230)
    Texto.Font = Enum.Font.Gotham
    Texto.TextSize = 11
    Texto.TextXAlignment = Enum.TextXAlignment.Left
    Texto.Name = "Label_" .. Ordem
    Texto.Parent = Container
    return Texto
end

local Label_Exibicao = CriarTexto(1, "Nome de exibição", NomeExibicao)
local Label_Original = CriarTexto(2, "Nome da conta", NomeJogador)
local Label_Executor = CriarTexto(3, "Executor", NomeExecutor)
local Label_Horas = CriarTexto(4, "Horário", PegarHoras())

task.spawn(function()
    while task.wait(10) do
        if Label_Horas and Label_Horas.Parent then
            Label_Horas.Text = "Horário: " .. PegarHoras()
        else
            break
        end
    end
end)

-- ===========================================
-- ARRASTAR A INTERFACE (MÓVEL)
-- ===========================================

local Arrastando = false
local InicioPos, InicioToque

Janela.InputBegan:Connect(function(t)
    if t.UserInputType == Enum.UserInputType.MouseButton1 or t.UserInputType == Enum.UserInputType.Touch then
        -- Impede de arrastar ao clicar diretamente no botão X
        if UserInputService:GetFocusedTextBox() == nil then
            Arrastando = true
            InicioPos = Janela.Position
            InicioToque = t.Position
        end
    end
end)

UserInputService.InputChanged:Connect(function(t)
    if Arrastando and (t.UserInputType == Enum.UserInputType.MouseMovement or t.UserInputType == Enum.UserInputType.Touch) then
        local Delta = t.Position - InicioToque
        Janela.Position = UDim2.new(
            InicioPos.X.Scale,
            InicioPos.X.Offset + Delta.X,
            InicioPos.Y.Scale,
            InicioPos.Y.Offset + Delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(t)
    if t.UserInputType == Enum.UserInputType.MouseButton1 or t.UserInputType == Enum.UserInputType.Touch then
        Arrastando = false
    end
end)
