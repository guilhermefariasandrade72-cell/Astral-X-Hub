local function TemArma()
    local localPlayer = game:GetService("Players").LocalPlayer
    if not localPlayer then return false end
    local char = localPlayer.Character
    if not char then return false end
    
    local armaNoChar = char:FindFirstChild("Gun")
    if not armaNoChar then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and item.Name:lower():find("gun") then
                armaNoChar = item
                break
            end
        end
    end
    if armaNoChar then return true end

    local backpack = localPlayer:FindFirstChild("Backpack")
    if backpack then
        local armaNaMochila = backpack:FindFirstChild("Gun")
        if not armaNaMochila then
            for _, item in ipairs(backpack:GetChildren()) do
                if item:IsA("Tool") and item.Name:lower():find("gun") then
                    armaNaMochila = item
                    break
                end
            end
        end
        if armaNaMochila then return true end
    end

    return false
end

local function ObterMurderer()
    local localPlayer = game:GetService("Players").LocalPlayer
    if not localPlayer then return nil end
    
    for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local char = p.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            
            if hum and hum.Health > 0 and hrp then
                local temFaca = char:FindFirstChild("Knife") or (p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild("Knife"))
                local eMurder = (p:GetAttribute("Role") == "Murderer") or (temFaca ~= nil)
                
                if eMurder then
                    return hrp
                end
            end
        end
    end
    return nil
end

local function EstaDentroDoFOV(posicao3D)
    local camera = workspace.CurrentCamera
    if not camera then return false end
    
    local posTela, visivel = camera:WorldToViewportPoint(posicao3D)
    if not visivel then return false end

    local centroTela = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local posAlvo2D = Vector2.new(posTela.X, posTela.Y)
    
    local distanciaPixels = (posAlvo2D - centroTela).Magnitude
    return distanciaPixels <= (RaioFOV / 2)
end

