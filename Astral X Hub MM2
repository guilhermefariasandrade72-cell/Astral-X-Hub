            Input.Changed:Connect(function()

                if Input.UserInputState ==
                    Enum.UserInputState.End then

                    isDraggingKill =
                        false

                end

            end)

        end

    end)


    Btn.InputChanged:Connect(function(Input)

        if isDraggingKill
            and (
                Input.UserInputType ==
                    Enum.UserInputType.Touch

                or Input.UserInputType ==
                    Enum.UserInputType.MouseMovement
            ) then

            Btn.Position =
                buttonStartPosKill
                + UDim2.fromOffset(

                    Input.Position.X
                        - dragStartPosKill.X,

                    Input.Position.Y
                        - dragStartPosKill.Y

                )

        end

    end)


    -- ===========================================
    -- 👆 CLIQUE + ANIMAÇÃO CENTRALIZADA
    -- ===========================================

    Btn.MouseButton1Click:Connect(function()

        if isDraggingKill then
            return
        end


        -- Evita acumular animações
        ButtonScale.Scale =
            1


        -- 🔽 DIMINUI PARA DENTRO
        local Encolher =
            TweenService:Create(

                ButtonScale,

                TweenInfo.new(

                    0.08,

                    Enum.EasingStyle.Quad,

                    Enum.EasingDirection.Out

                ),

                {
                    Scale = 0.88
                }

            )


        -- 🔼 CRESCE DO CENTRO PARA FORA
        local Crescer =
            TweenService:Create(

                ButtonScale,

                TweenInfo.new(

                    0.12,

                    Enum.EasingStyle.Back,

                    Enum.EasingDirection.Out

                ),

                {
                    Scale = 1
                }

            )


        Encolher:Play()


        Encolher.Completed:Once(function()

            Crescer:Play()

        end)


        -- =======================================
        -- 🗡️ EXECUTA O KILL ALL
        -- =======================================

        KillAllInstantaneo()

    end)


    -- ===========================================
    -- 💾 SALVAR GUI
    -- ===========================================

    KillAllButtonGui =
        GuiBtn


    -- ===========================================
    -- ⭐ APLICAR FORMATO INICIAL
    -- ===========================================

    AtualizarKillAllButton()

end


