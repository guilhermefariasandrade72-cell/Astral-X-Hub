                    or arma:FindFirstChild("ShootEvent") 
                    or ReplicatedStorage:FindFirstChild("Shoot", true)
                
                if shootEvent and shootEvent:IsA("RemoteEvent") then
                    local veloc = hrpMurderer.AssemblyLinearVelocity
                    local posComPrevisao = hrpMurderer.Position + (veloc * (PRECISAO_FIXA / 100))
                    
                    pcall(function()
                        shootEvent:FireServer(hrp.CFrame, CFrame.new(posComPrevisao))
                    end)
                end
            end

            tempoComArma = tempoComArma + 0.15

            if tempoComArma >= 10.0 then
                if arma and arma.Parent == char then
                    arma.Parent = backpack
                end
                estaComArma = false
                tempoComArma = 0
                tempoSemArma = 0
            end
        else
            tempoSemArma = tempoSemArma + 0.15

            if tempoSemArma >= 1.0 then
                if arma then
                    arma.Parent = char
                end
                estaComArma = true
                tempoSemArma = 0
            end
        end

        task.wait(0.15)
    end

    -- 🔹 PASSO 5: Murderer morreu — Desliga invisibilidade e volta para a plataforma
    InvisivelAtivo = false

    if hrp and posOriginal then
        hrp.CFrame = posOriginal
    end

    -- 🔄 PASSO 6: Aguarda a bolsa esvaziar/reiniciar partida para rearmar
    repeat
        RunService.Heartbeat:Wait()
    until not AutoShootAtivo 
       or (EmPartida and not EmPartida()) 
       or not (BolsaCheia or (VerificarTextoBolsaCheia and VerificarTextoBolsaCheia())) 
       or player:GetAttribute("Alive") ~= true

    ExecutandoShoot = false
end

-- 🔄 LOOP DE EXECUÇÃO CONTÍNUA
task.spawn(function()
    while true do
        if AutoShootAtivo and not ExecutandoShoot then
            IniciarSequenciaShoot()
        end
        RunService.Heartbeat:Wait()
    end
end)

