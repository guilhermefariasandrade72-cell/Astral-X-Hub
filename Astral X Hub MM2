local SafePlatform = nil
local SafePosition = Vector3.new(38013.93, 1101.06, -26257.38)

local function TeleportarParaSafe()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Cria a plataforma no local se ela ainda não existir
    if not SafePlatform or not SafePlatform.Parent then
        SafePlatform = Instance.new("Part")
        SafePlatform.Name = "AstralX_SafePlatform"
        SafePlatform.Size = Vector3.new(20, 2, 20)
        SafePlatform.Position = SafePosition
        SafePlatform.Anchored = true
        SafePlatform.Color = Color3.fromRGB(0, 0, 0) -- Cor preta
        SafePlatform.Transparency = 0.5            -- Semi-transparente
        SafePlatform.Material = Enum.Material.SmoothPlastic
        SafePlatform.CanCollide = true
        SafePlatform.Parent = workspace
    end

    -- Teleporta o jogador para cima da plataforma
    hrp.CFrame = CFrame.new(SafePosition + Vector3.new(0, 3, 0))
end


