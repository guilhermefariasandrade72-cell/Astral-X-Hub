-- ===========================================

local function KillAllInstantaneo()
    for _, Alvo in ipairs(Players:GetPlayers()) do
        if Alvo ~= player
            and Alvo.Character
            and Alvo.Character:FindFirstChild("Head") then
            
            ExecutarAtaque(Alvo)
        end
    end
end

-- ⚔️ LOOP DO KILL ALL / KILL AURA ANTIGO
local function KillAuraLoop()
    for _, Alvo in ipairs(Players:GetPlayers()) do
        if not KillAura then break end
        
        if Alvo ~= player
            and Alvo.Character
            and Alvo.Character:FindFirstChild("Head") then
            
            ExecutarAtaque(Alvo)
            task.wait(0.15)
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.3)

        if KillAura then
            KillAuraLoop()
        end
    end
end)


