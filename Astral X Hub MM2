local function PegarListaJogadores()
    local lista = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            table.insert(lista, p.Name)
        end
    end

    table.sort(lista)

    if #lista == 0 then
        table.insert(lista, "Nenhum Jogador")
    end

    return lista
end


