local function GetMapSpawn()
    -- Procura o container do mapa atual no Workspace
    local coinContainer = workspace:FindFirstChild("CoinContainer", true)
    if coinContainer and coinContainer.Parent then
        local map = coinContainer.Parent
        local spawns = map:FindFirstChild("Spawns") or map:FindFirstChild("Spawn")
        
        if spawns then
            local partesSpawn = spawns:GetChildren()
            if #partesSpawn > 0 then
                return partesSpawn[math.random(1, #partesSpawn)].CFrame + Vector3.new(0, 3, 0)
            end
        end
        
        -- Caso não ache uma pasta de spawns, usa a posição central do próprio mapa
        if map:IsA("Model") then
            local cf, _ = map:GetBoundingBox()
            return cf + Vector3.new(0, 5, 0)
        end
    end
    return nil
end

local function GetLobbySpawn()
    -- 📍 Coordenada fixa gravada (Posiciona 3 studs acima para evitar cair no chão)
    local posLobby = Vector3.new(-0.32, -67.11, -31.52)
    
    -- Se encontrar a pasta ou modelo do Lobby no Workspace, tenta pegar um Spawn oficial
    local lobby = workspace:FindFirstChild("Lobby") or workspace:FindFirstChild("LobbyMap")
    if lobby then
        local spawns = lobby:FindFirstChild("Spawns") or lobby:FindFirstChild("Spawn")
        if spawns then
            local partesSpawn = spawns:GetChildren()
            if #partesSpawn > 0 then
                return partesSpawn[math.random(1, #partesSpawn)].CFrame + Vector3.new(0, 3, 0)
            end
        end
    end

    -- Retorna a coordenada exata enviada
    return CFrame.new(posLobby + Vector3.new(0, 3, 0))
end

