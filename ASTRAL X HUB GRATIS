-- ⚙️ SISTEMA ESP
-- ===========================================
local function PegarCargos()
    local R = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if not R then return end
    local ok, d = pcall(function() return R:InvokeServer() end)
    if ok and d then DadosCargos = d end
end

local function EstaVivo(Nome)
    local Info = DadosCargos[Nome]
    return Info and not Info.Killed and not Info.Dead
end

local function CriarHighlight(Alvo, Cor, Tabela)
    if not Alvo then return end
    if not Tabela[Alvo] then
        local H = Instance.new("Highlight")
        H.Name = "ESP_Astral"
        H.Adornee = Alvo
        H.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        H.OutlineTransparency = 0
        H.Parent = Alvo
        Tabela[Alvo] = H
    end
    Tabela[Alvo].FillColor = Cor
    Tabela[Alvo].OutlineColor = Cor
    Tabela[Alvo].Enabled = true
end

local function LimparESP(Tabela)
    for _,h in pairs(Tabela) do if h then h:Destroy() end end
    table.clear(Tabela)
end

