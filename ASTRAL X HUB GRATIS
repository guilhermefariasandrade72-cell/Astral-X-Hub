-- ✨ ESTRELAS NO FUNDO
local Estrelas = Instance.new("Frame")
Estrelas.Size = UDim2.new(1, 0, 1, 0)
Estrelas.BackgroundTransparency = 1
Estrelas.Parent = Janela
local ListaEstrelas = {}
for i = 1, 35 do
    local E = Instance.new("Frame")
    E.Size = UDim2.new(0, math.random(2, 4), 0, math.random(2, 4))
    E.Position = UDim2.new(math.random(), 0, math.random(), 0)
    E.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    E.BackgroundTransparency = math.random(4, 7)/10
    E.Parent = Estrelas
    table.insert(ListaEstrelas, {Frame=E, Vx=(math.random()-0.5)*0.0006, Vy=(math.random()-0.5)*0.0006})
end
RunService.RenderStepped:Connect(function()
    for _,e in ipairs(ListaEstrelas) do
        local x = e.Frame.Position.X.Scale + e.Vx
        local y = e.Frame.Position.Y.Scale + e.Vy
        e.Frame.Position = UDim2.new(x<0 and 1 or x>1 and 0 or x,0, y<0 and 1 or y>1 and 0 or y,0)
    end
end)

