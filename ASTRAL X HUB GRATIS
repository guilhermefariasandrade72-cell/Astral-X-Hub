-- ===========================================
-- 🔧 SISTEMA DE ARRASTAR E MINIMIZAR (NÃO MEXER)
-- ===========================================
local TamanhoNormal = UDim2.fromOffset(240, 300)
local TamanhoMinimo = UDim2.fromOffset(240, 35)
local Minimizado = false
local Arrastando = false
local InicioPos, InicioMouse

Barra.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        Arrastando = true
        InicioPos = Janela.Position
        InicioMouse = UserInputService:GetMouseLocation()
    end
end)

UserInputService.InputChanged:Connect(function(i)
    if Arrastando and i.UserInputType == Enum.UserInputType.MouseMovement then
        local D = i.Position - InicioMouse
        Janela.Position = UDim2.new(InicioPos.X.Scale, InicioPos.X.Offset+D.X, InicioPos.Y.Scale, InicioPos.Y.Offset+D.Y)
    end
end)

Barra.InputEnded:Connect(function(i) Arrastando = false end)

BtnMin.MouseButton1Click:Connect(function()
    if not Minimizado then
        TweenService:Create(Janela, TweenInfo.new(0.3), {Size = TamanhoMinimo}):Play()
        Conteudo.Visible = false
        BtnMin.Text = "+"
        Minimizado = true
    else
        TweenService:Create(Janela, TweenInfo.new(0.3), {Size = TamanhoNormal}):Play()
        Conteudo.Visible = true
        BtnMin.Text = "—"
        Minimizado = false
    end
end)

BtnFechar.MouseButton1Click:Connect(function() Gui:Destroy() end)
