-- 🎯 SILENT AIM
-- ===========================================
local function GetPing()
    local ok, value = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return ok and value or 100
end

local function GetMurderer()
    local DataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if not DataRemote then return nil end
    local ok, Data = pcall(function() return DataRemote:InvokeServer() end)
    if not ok or not Data then return nil end
    for _, Player in next, Players:GetPlayers() do
        if Player ~= player and Player:GetAttribute("Alive") then
            local Info = Data[Player.Name]
            if Info and Info.Role == "Murderer" then return Player end
        end
    end
    return nil
end

local function ShootMurderer()
    local Char = player.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then return end
    local Gun = Char:FindFirstChild("Gun") or (player.Backpack and player.Backpack:FindFirstChild("Gun"))
    if not Gun then return end
    if Gun.Parent ~= Char then Gun.Parent = Char task.wait(0.05) end
    local Murderer = GetMurderer()
    if not Murderer or not Murderer.Character then return end
    local TargetHRP = Murderer.Character:FindFirstChild("HumanoidRootPart")
    local TargetTorso = Murderer.Character:FindFirstChild("Torso") or Murderer.Character:FindFirstChild("UpperTorso")
    if not TargetHRP or not TargetTorso then return end
    local Ping = GetPing()
    local PredictionTime = (Ping / 1000) * ShootPredictMultiplier
    local Velocity = TargetHRP.Velocity
    local PredictedPos = Velocity.Magnitude < 1 and TargetTorso.Position or TargetTorso.Position + (Velocity * PredictionTime)
    local OriginCFrame = MagicBullet and CFrame.new(TargetTorso.Position, PredictedPos) or CFrame.new(Char.HumanoidRootPart.Position, PredictedPos)
    local ShootEvent = Gun:FindFirstChild("ShootEvent", true) or Gun:FindFirstChild("Shoot", true)
    if ShootEvent then ShootEvent:FireServer(OriginCFrame, CFrame.new(PredictedPos)) end
end

-- ===========================================
-- 🧲 GRAB GUN
-- ===========================================
local function FindMap()
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:GetAttribute("MapID") then return child end
    end
    return nil
end

local function GetPlayerRole()
    local R = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if not R then return nil end
    local ok, D = pcall(function() return R:InvokeServer() end)
    if not ok or not D then return nil end
    return D[player.Name] and D[player.Name].Role or nil
end

local function IsMurderer() return GetPlayerRole() == "Murderer" end

local function GetGun()
    if not AutoGrabGun then return end
    pcall(function()
        if not player:GetAttribute("Alive") then return end
        if IsMurderer() then return end
        local map = FindMap()
        local char = player.Character
        if not map or not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local gunDrop = map:FindFirstChild("GunDrop")
        if gunDrop then gunDrop.CFrame = char.HumanoidRootPart.CFrame end
    end)
end

-- ===========================================
-- 🗡️ KILL AURA
-- ===========================================
local function CalcularDistancia(Alvo)
    local MeuChar = player.Character
    if not MeuChar or not MeuChar:FindFirstChild("HumanoidRootPart") then return 99999999999999167 end
    if not Alvo or not Alvo.Character or not Alvo.Character:FindFirstChild("HumanoidRootPart") then return 99999999999999167 end
    return (MeuChar.HumanoidRootPart.Position - Alvo.Character.HumanoidRootPart.Position).Magnitude
end

local function KillAuraFuncao()
    if not KillAura then return end
    local Char = player.Character
    if not Char then return end
    local Faca = Char:FindFirstChild("Knife") or (player.Backpack and player.Backpack:FindFirstChild("Knife"))
    if not Faca then return end
    if Faca.Parent ~= Char then Faca.Parent = Char task.wait(0.05) end
    local Eventos = Faca:FindFirstChild("Events")
    if not Eventos then return end
    for _, Alvo in ipairs(Players:GetPlayers()) do
        if Alvo ~= player and Alvo.Character and Alvo.Character:FindFirstChild("Head") then
            if CalcularDistancia(Alvo) <= KillAuraDistancia then
                pcall(function()
                    Eventos.KnifeStabbed:FireServer()
                    Eventos.HandleTouched:FireServer(Alvo.Character.Head)
                end)
                task.wait(0.05)
            end
        end
    end
end

