local function EmPartida()
    local c = player.Character
    if not c or not c:FindFirstChild("Humanoid") or c.Humanoid.Health <= 0 then return false end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            return true
        end
    end
    return false
end

local function QuantidadeMochila()
    local ok, n = pcall(function()
        local g = player.PlayerGui:WaitForChild("MainGUI", 2)
        return tonumber(g.Game.CoinBags.Container.SnowToken.CurrencyFrame.Icon.Coins.Text) or 0
    end)
    return ok and n or 0
end

local function getNearestCoin(minhaPos)
    local melhor, menorDist = nil, math.huge
    local CoinContainer = Workspace:FindFirstChild("CoinContainer", true)
    if not CoinContainer then return end
    for _, v in ipairs(CoinContainer:GetChildren()) do
        if v:IsA("BasePart") and v.Name == "Coin_Server"
        and v:FindFirstChild("TouchInterest") and v:FindFirstChild("CoinVisual")
        and not collectedCoins[v] and not v:GetAttribute("Collected") then
            local dist = (minhaPos - v.Position).Magnitude
            if dist < CONFIG_FARM.alcance_maximo and dist < menorDist then
                menorDist = dist
                melhor = v
            end
        end
    end
    return melhor
end

local function MoedaValida(alvo)
    if not alvo then return false end
    if not alvo.Parent then return false end
    if alvo:GetAttribute("Collected") then return false end
    if not alvo:FindFirstChild("TouchInterest") then return false end
    if not alvo:FindFirstChild("CoinVisual") then return false end
    if collectedCoins[alvo] then return false end
    return true
end

-- ===========================================
-- 🔄 LOOP PRINCIPAL — AUTO FARM INTELIGENTE
-- ===========================================
task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()

        -- ✅ ESP — SÓ RODA SE LIGADO
        if ESPPlayerAtivo then
            PegarCargos()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character and EstaVivo(p.Name) then
                    local Info = DadosCargos[p.Name]
                    local Cor = Color3.fromRGB(60, 200, 80)
                    if Info then
                        if Info.Role == "Murderer" then Cor = Color3.fromRGB(220, 50, 50)
                        elseif Info.Role == "Sheriff" then Cor = Color3.fromRGB(0, 0, 225)
                        elseif Info.Role == "Hero" then Cor = Color3.fromRGB(255, 215, 0) end
                    end
                    CriarHighlight(p.Character, Cor, Highlights)
                elseif Highlights[p.Character] then
                    Highlights[p.Character].Enabled = false
                end
            end
        else
            if next(Highlights) then LimparESP(Highlights) end
        end

        -- ✅ AUTO FARM INTELIGENTE
        if AutoFarmAtivo then
            -- 🔴 FORA DA PARTIDA → LIMPA E ESPERA
            if not EmPartida() then
                table.clear(collectedCoins)
                RunService.Heartbeat:Wait()
                continue
            end

            local atual = QuantidadeMochila()

            -- 🟡 BOLSA CHEIA → ESPERA A PARTIDA REINICIAR
            if atual >= CONFIG_FARM.limite then
                repeat
                    RunService.Heartbeat:Wait()
                    atual = QuantidadeMochila()
                    if not EmPartida() then
                        table.clear(collectedCoins)
                        break
                    end
                until atual < CONFIG_FARM.limite or not AutoFarmAtivo
                table.clear(collectedCoins)
                continue
            end

            local c = player.Character
            if not c or not c.PrimaryPart then
                RunService.Heartbeat:Wait()
                continue
            end

            -- ✅ PEGA MOEDA MAIS PRÓXIMA
            local minhaPos = c.PrimaryPart.Position
            local alvo = getNearestCoin(minhaPos)

            -- ❌ SEM MOEDA → ESPERA
            if not alvo then
                table.clear(collectedCoins)
                RunService.Heartbeat:Wait()
                continue
            end

            -- ✅ VAI ATÉ A MOEDA
            local ini = minhaPos
            local destino = alvo.Position
            local distTotal = (ini - destino).Magnitude
            local tempo = distTotal / CONFIG_FARM.velocidade
            local tIni = os.clock()

            -- 🔄 A CADA PASSO → TROCA SE APARECER MOEDA MAIS PERTO
            while AutoFarmAtivo and EmPartida() 
            and QuantidadeMochila() < CONFIG_FARM.limite 
            and MoedaValida(alvo) do

                -- ⚡ APARECEU MOEDA MAIS PRÓXIMA? TROCA AGORA!
                local posAtual = c.PrimaryPart.Position
                local melhorNova = getNearestCoin(posAtual)
                if melhorNova and melhorNova ~= alvo then
                    local distAtual = (posAtual - destino).Magnitude
                    local distNova = (posAtual - melhorNova.Position).Magnitude
                    if distNova < distAtual then
                        alvo = melhorNova
                        ini = posAtual
                        destino = alvo.Position
                        distTotal = (ini - destino).Magnitude
                        tempo = distTotal / CONFIG_FARM.velocidade
                        tIni = os.clock()
                    end
                end

                -- 🚀 CONTINUA ANDANDO
                local progresso = math.min((os.clock() - tIni) / tempo, 0,1)
                c:PivotTo(CFrame.new(ini:Lerp(destino, progresso)))

                -- ✅ CHEGOU
                if progresso >= 1 then break end

                RunService.Heartbeat:Wait()
            end

            -- ✅ MARCA COMO COLETADA
            if MoedaValida(alvo) then
                collectedCoins[alvo] = true
            end
        end
    end
end)

