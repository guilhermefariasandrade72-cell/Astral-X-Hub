-- 08. SISTEMAS DO ESP
--==================================================
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local function PegarCargos()
    if tick() - UltimaChecagemCargo < 2 then return end
    UltimaChecagemCargo = tick()
    task.spawn(function()
        local R = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
        if not R then return end
        local ok, d = pcall(function() return R:InvokeServer() end)
        if ok and d then DadosCargos = d end
    end)
end

local function CriarHighlight(Alvo, Cor)
    if not Alvo then return end
    local H = Highlights[Alvo]
    if not H or H.Parent ~= Alvo then
        H = Instance.new("Highlight")
        H.Name = "ESP_Highlight"
        H.Adornee = Alvo
        H.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        H.OutlineTransparency = 0
        H.Parent = Alvo
        Highlights[Alvo] = H
    end
    H.FillColor = Cor
    H.OutlineColor = Cor
    H.Enabled = true
end

local function CriarTextESP(Jogador, Cor, TextoExibido)
    local Char = Jogador.Character
    if not Char or not Char:FindFirstChild("Head") then return end
    local Head = Char.Head
    local Data = NamesESP[Jogador]
    if not Data or not Data.Gui or Data.Gui.Parent ~= Head then
        if Data and Data.Gui then Data.Gui:Destroy() end
        local BGui = Instance.new("BillboardGui")
        BGui.Name = "ESP_Text"
        BGui.Adornee = Head
        BGui.Size = UDim2.new(0, 200, 0, 40)
        BGui.StudsOffset = Vector3.new(0, 2.5, 0)
        BGui.AlwaysOnTop = true
        local TextLabel = Instance.new("TextLabel")
        TextLabel.Name = "Label"
        TextLabel.Size = UDim2.new(1, 0, 1, 0)
        TextLabel.BackgroundTransparency = 1
        TextLabel.Font = Enum.Font.SourceSansBold
        TextLabel.TextSize = 13
        TextLabel.TextStrokeTransparency = 0
        TextLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        TextLabel.Parent = BGui
        BGui.Parent = Head
        Data = {Gui = BGui, Label = TextLabel}
        NamesESP[Jogador] = Data
    end
    Data.Label.Text = TextoExibido
    Data.Label.TextColor3 = Cor
    Data.Gui.Enabled = true
end

local function LimparJogadorESP(p)
    if p and p.Character and Highlights[p.Character] then
        Highlights[p.Character]:Destroy()
        Highlights[p.Character] = nil
    end
    if p and NamesESP[p] then
        if NamesESP[p].Gui then NamesESP[p].Gui:Destroy() end
        NamesESP[p] = nil
    end
    if p and TracersESP[p] then
        TracersESP[p].Visible = false
        TracersESP[p]:Remove()
        TracersESP[p] = nil
    end
end

local function LimparTabela(Tabela)
    for key, item in pairs(Tabela) do
        if typeof(item) == "Instance" then item:Destroy()
        elseif type(item) == "table" and item.Gui then item.Gui:Destroy()
        elseif type(item) == "userdata" and item.Remove then item.Visible = false; item:Remove() end
    end
    table.clear(Tabela)
end

Players.PlayerRemoving:Connect(function(p)
    LimparJogadorESP(p)
end)

RunService.RenderStepped:Connect(function()
    if not ESPTracerAtivo then
        for p, line in pairs(TracersESP) do if line then line.Visible = false end end
        return
    end
    local Cam = Workspace.CurrentCamera
    if not Cam then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player then
            local Char = p.Character
            local Humanoid = Char and Char:FindFirstChildOfClass("Humanoid")
            local HRP = Char and Char:FindFirstChild("HumanoidRootPart")
            if Char and HRP and Humanoid and Humanoid.Health > 0 then
                local Vector, OnScreen = Cam:WorldToViewportPoint(HRP.Position)
                local Line = TracersESP[p]
                if not Line then
                    Line = Drawing.new("Line")
                    Line.Thickness = 1.5
                    Line.Transparency = 0.8
                    TracersESP[p] = Line
                end
                if OnScreen then
                    local Info = DadosCargos[p.Name]
                    local Cor = Color3.fromRGB(255, 255, 255)
                    if Info and not Info.Killed and not Info.Dead then
                        if Info.Role == "Murderer" then Cor = Color3.fromRGB(220, 50, 50)
                        elseif Info.Role == "Sheriff" then Cor = Color3.fromRGB(0, 85, 255)
                        elseif Info.Role == "Hero" then Cor = Color3.fromRGB(255, 215, 0)
                        elseif Info.Role == "Innocent" then Cor = Color3.fromRGB(60, 200, 80) end
                    end
                    Line.From = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y)
                    Line.To = Vector2.new(Vector.X, Vector.Y)
                    Line.Color = Cor
                    Line.Visible = true
                else
                    Line.Visible = false
                end
            else
                if TracersESP[p] then TracersESP[p].Visible = false end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.3)
        if ESPHighlightAtivo or ESPNomeAtivo or ESPDistanciaAtiva or ESPTracerAtivo then
            PegarCargos()
            local MeuChar = Player.Character
            local MinhaPos = (MeuChar and MeuChar:FindFirstChild("HumanoidRootPart")) and MeuChar.HumanoidRootPart.Position or Vector3.new(0,0,0)
            for p, _ in pairs(NamesESP) do
                if not Players:FindFirstChild(p.Name) then LimparJogadorESP(p) end
            end
            for _, p in ipairs(Players:GetPlayers()) do
                local Char = p.Character
                local Humanoid = Char and Char:FindFirstChildOfClass("Humanoid")
                local HRP = Char and Char:FindFirstChild("HumanoidRootPart")
                if p == Player or not Char or not HRP or not Humanoid or Humanoid.Health <= 0 then
                    LimparJogadorESP(p)
                else
                    local Info = DadosCargos[p.Name]
                    local Cor = Color3.fromRGB(255, 255, 255)
                    local CargoNome = "Lobby"
                    if Info and not Info.Killed and not Info.Dead then
                        if Info.Role == "Murderer" then Cor = Color3.fromRGB(220, 50, 50); CargoNome = "Assassino"
                        elseif Info.Role == "Sheriff" then Cor = Color3.fromRGB(0, 85, 255); CargoNome = "Xerife"
                        elseif Info.Role == "Hero" then Cor = Color3.fromRGB(255, 215, 0); CargoNome = "HerÃ³i"
                        elseif Info.Role == "Innocent" then Cor = Color3.fromRGB(60, 200, 80); CargoNome = "Inocente" end
                    end
                    local Distancia = math.floor((MinhaPos - HRP.Position).Magnitude)
                    if ESPHighlightAtivo then
                        CriarHighlight(Char, Cor)
                    elseif Highlights[Char] then
                        Highlights[Char].Enabled = false
                    end
                    if ESPNomeAtivo or ESPDistanciaAtiva then
                        local TextoFinal = ""
                        if ESPNomeAtivo and ESPDistanciaAtiva then
                            TextoFinal = p.Name .. " [" .. CargoNome .. "]\n" .. Distancia .. "m"
                        elseif ESPNomeAtivo then
                            TextoFinal = p.Name .. " [" .. CargoNome .. "]"
                        else
                            TextoFinal = Distancia .. "m"
                        end
                        CriarTextESP(p, Cor, TextoFinal)
                    elseif NamesESP[p] and NamesESP[p].Gui then
                        NamesESP[p].Gui.Enabled = false
                    end
                end
            end
        else
            if next(Highlights) then LimparTabela(Highlights) end
            if next(NamesESP) then LimparTabela(NamesESP) end
            if next(TracersESP) then LimparTabela(TracersESP) end
        end
    end
end)

-- ==================================
-- 🧱 SISTEMA DO X-RAY
-- ==================================
local function AplicarXRay()
    for _, Descendente in ipairs(workspace:GetDescendants()) do
        if Descendente:IsA("BasePart") and not Descendente:IsA("Terrain") then
            
            -- ✅ IGNORA PERSONAGENS DE JOGADORES (Muito mais rápido que GetFullName)
            local EhJogador = false
            for _, Jogador in ipairs(Players:GetPlayers()) do
                if Jogador.Character and Descendente:IsDescendantOf(Jogador.Character) then
                    EhJogador = true
                    break
                end
            end
            
            if not EhJogador then
                -- Salva a transparência original apenas se a parte ainda não foi salva
                if ValoresOriginais[Descendente] == nil then
                    ValoresOriginais[Descendente] = Descendente.Transparency
                end

                -- Aplica a transparência
                if Descendente.Transparency < 0.65 then
                    Descendente.Transparency = 0.65
                    Descendente.LocalTransparencyModifier = 0
                end
            end
        end
    end
end

local function AtivarXRay()
    if XRayAtivo then return end
    XRayAtivo = true
    AplicarXRay()
end

local function RemoverXRay()
    if not XRayAtivo then return end
    XRayAtivo = false

    for Parte, TranspOriginal in pairs(ValoresOriginais) do
        if Parte and Parte.Parent then
            Parte.Transparency = TranspOriginal
            Parte.LocalTransparencyModifier = 0
        end
    end
    table.clear(ValoresOriginais)
end

-- 🔄 ATUALIZAÇÃO CONTÍNUA (Mapeia novas partes sem travar o código)
task.spawn(function()
    while true do
        task.wait(0.5)
        if XRayAtivo then
            AplicarXRay()
        end
    end
end)

-- ==================================
-- 💰 SISTEMA DO HIGHLIGHT DE MOEDAS
-- ==================================
local function DestacarMoedas()
    for _, Descendente in ipairs(workspace:GetDescendants()) do
        if Descendente:IsA("BasePart") then
            local Nome = Descendente.Name:lower()
            
            -- Encontra moedas
            if string.find(Nome, "coin") or string.find(Nome, "Coin") then
                if not MoedasDestacadas[Descendente] then
                    local Highlight = Instance.new("Highlight")
                    Highlight.Name = "Moeda_Highlight"
                    Highlight.FillTransparency = 0.3
                    Highlight.OutlineTransparency = 0
                    Highlight.FillColor = Color3.fromRGB(255, 215, 0)  -- 💰 AMARELO
                    Highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
                    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    Highlight.Adornee = Descendente
                    Highlight.Parent = Descendente
                    MoedasDestacadas[Descendente] = Highlight
                end
            end
        end
    end
end

local function RemoverDestaqueMoedas()
    for Parte, Highlight in pairs(MoedasDestacadas) do
        if Highlight and Highlight.Parent then
            Highlight:Destroy()
        end
    end
    table.clear(MoedasDestacadas)
end

-- 🔄 ATUALIZAÇÃO CONTÍNUA
task.spawn(function()
    while true do
        task.wait(0.5)
        if MoedasHighlightAtivo then
            DestacarMoedas()
        end
    end
end)





















-- ==================================
-- 🦘 PULO INFINITO — VARIÁVEIS
-- ==================================
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

-- ==================================
-- 🦘 SISTEMA DO PULO INFINITO
-- ==================================
local function ToggleInfiniteJump(state)
    InfiniteJumpEnabled = state

    if InfiniteJumpConnection then
        InfiniteJumpConnection:Disconnect()
        InfiniteJumpConnection = nil
    end

    if state then
        InfiniteJumpConnection = UserInputService.JumpRequest:Connect(function()
            if not InfiniteJumpEnabled then return end

            -- Limita a frequência para evitar múltiplos impulsos em um único clique (Debounce de 0.15s)
            if tick() - UltimoPulo < 0.15 then return end

            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local hrp = character and character:FindFirstChild("HumanoidRootPart")

            if humanoid and hrp then
                UltimoPulo = tick()
                
                -- Mantém a velocidade horizontal atual (X e Z) e aplica força apenas na vertical (Y)
                hrp.AssemblyLinearVelocity = Vector3.new(
                    hrp.AssemblyLinearVelocity.X,
                    humanoid.JumpPower > 0 and humanoid.JumpPower or 50, -- Força padrão de pulo
                    hrp.AssemblyLinearVelocity.Z
                )
            end
        end)
    end
end

-- Reativa automaticamente ao respawnar
player.CharacterAdded:Connect(function()
    task.wait(0.5)
    if InfiniteJumpEnabled then
        ToggleInfiniteJump(true)
    end
end)

-- ==================================
-- ✈️ SISTEMA DE FLY (MODO HUB — SEU CÓDIGO EXATO)
-- ==================================

local function StartFly()
    local c = player.Character
    if not c then return end
    local h = c:FindFirstChild("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r then return end

    if bv then bv:Destroy() end
    if bg then bg:Destroy() end

    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.P = 3000
    bv.Parent = r

    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.P = 30000
    bg.D = 500
    bg.CFrame = r.CFrame
    bg.Parent = r

    h.PlatformStand = true -- 🔄 Ativa o estado idêntico ao do Hub

    if con then con:Disconnect() end
    con = RunService.Heartbeat:Connect(function()
        if not FlyAtivo or not bv or not bg or not controls then return end
        local cam = workspace.CurrentCamera
        local m = controls:GetMoveVector()
        local dir = (cam.CFrame.RightVector * m.X) + (cam.CFrame.LookVector * -m.Z)
        
        bv.Velocity = dir * FlyVelocidade
        bg.CFrame = cam.CFrame
    end)
end

local function StopFly()
    FlyAtivo = false
    if con then con:Disconnect() con = nil end
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end

    local c = player.Character
    if c and c:FindFirstChild("Humanoid") then
        c.Humanoid.PlatformStand = false -- 🔄 Volta o personagem ao normal
    end
end

local function ToggleFly(state)
    FlyAtivo = state
    if FlyAtivo then
        StartFly()
    else
        StopFly()
    end
end

player.CharacterAdded:Connect(function()
    task.wait(0.8)
    if FlyAtivo then 
        StartFly() 
    end
end)


-- ==================================
-- 🧱 SISTEMA DO NOCLIP
-- ==================================
RunService.Heartbeat:Connect(function()
    if not NoclipAtivo then return end
    local char = player.Character
    if not char then return end
    
    -- Desativa colisão em todas as partes do corpo
    for _, Parte in pairs(char:GetDescendants()) do
        if Parte:IsA("BasePart") then
            Parte.CanCollide = false
        end
    end
end)

-- Restaura colisão ao desligar
local function RestaurarColisao()
    local char = player.Character
    if not char then return end
    for _, Parte in pairs(char:GetDescendants()) do
        if Parte:IsA("BasePart") and Parte.Name ~= "HumanoidRootPart" then
            Parte.CanCollide = true
        end
    end
end

-- Reativa ao respawnar
player.CharacterAdded:Connect(function()
    task.wait(0.3)
    if NoclipAtivo then
        -- O Heartbeat já cuida de desativar a colisão
    end
end)

-- ==================================
-- 🌪️ SISTEMA DE WALK FLING (SEU CÓDIGO NOVO)
-- ==================================
local function ToggleWalkFling(state)
    WalkFlingAtivo = state

    if not WalkFlingAtivo then
        if FlingConnection then
            FlingConnection:Disconnect()
            FlingConnection = nil
        end
        return
    end

    FlingConnection = RunService.Heartbeat:Connect(function()
        if not WalkFlingAtivo then return end

        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        if hrp and humanoid then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end

            local oldCFrame = hrp.CFrame
            local vel = hrp.AssemblyLinearVelocity

            -- Aplica a velocidade fixa extrema
            hrp.CFrame = oldCFrame * CFrame.Angles(0, math.rad(math.random(1, 360)), 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, FlingPower, 0)

            RunService.RenderStepped:Wait()
            if hrp then
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                if humanoid.MoveDirection.Magnitude > 0 then
                    hrp.AssemblyLinearVelocity = vel
                else
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end
        end
    end)
end

player.CharacterAdded:Connect(function()
    if WalkFlingAtivo then
        task.wait(1.5)
        ToggleWalkFling(true)
    end
end)

-- ==================================
-- 🛡️ SISTEMA DO ANTI-FLING (SEU CÓDIGO)
-- ==================================
task.spawn(function()
    while true do
        if getgenv().AntiFling then
            pcall(function()
                for _, OtherPlayer in ipairs(game:GetService("Players"):GetPlayers()) do
                    if OtherPlayer ~= game:GetService("Players").LocalPlayer and OtherPlayer.Character then
                        for _, Part in ipairs(OtherPlayer.Character:GetChildren()) do
                            if Part:IsA("BasePart") then
                                Part.CanCollide = false
                                Part.AssemblyLinearVelocity = Vector3.zero
                                Part.AssemblyAngularVelocity = Vector3.zero
                            end
                        end
                    end
                end
            end)
        end
        game:GetService("RunService").Stepped:Wait()
    end
end)

