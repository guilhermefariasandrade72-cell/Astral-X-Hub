    if Old then
        Old:Destroy()
    end

end)


--==================================================
-- FUNÇÕES VISUAIS DA INTERFACE
--==================================================

local function Round(Object, Radius)

    local Corner =
        Instance.new("UICorner")

    Corner.CornerRadius =
        UDim.new(0, Radius)

    Corner.Parent = Object

    return Corner

end


local function AddStroke(
    Object,
    Transparency,
    Thickness
)

    local Stroke =
        Instance.new("UIStroke")

    Stroke.Color = White

    Stroke.Transparency =
        Transparency or 0

    Stroke.Thickness =
        Thickness or 1

    Stroke.Parent = Object

    return Stroke

end


