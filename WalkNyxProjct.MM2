AntiFlingToggle.BorderSizePixel = 0
AntiFlingToggle.Text = ""
AntiFlingToggle.AutoButtonColor = false
AntiFlingToggle.ZIndex = 7
AntiFlingToggle.Parent = AntiFlingBtnContainer
Round(AntiFlingToggle, 7)

local AntiFlingIndic = Instance.new("Frame")
AntiFlingIndic.Name = "Indicador"
AntiFlingIndic.Size = UDim2.fromOffset(20, 20)
AntiFlingIndic.Position = UDim2.new(0, 2, 0.5, -10)
AntiFlingIndic.BackgroundColor3 = Color3.fromRGB(140, 140, 145)
AntiFlingIndic.BorderSizePixel = 0
AntiFlingIndic.Parent = AntiFlingToggle
Round(AntiFlingIndic, 5)

local AntiFlingLigado = false

local function AtualizarAntiFlingToggle()
    if AntiFlingLigado then
        TweenService:Create(AntiFlingIndic, TweenInfo.new(0.15), {
            Position = UDim2.new(1, -22, 0.5, -10),
            BackgroundColor3 = White
        }):Play()
        AntiFlingToggle.BackgroundColor3 = Color3.fromRGB(45, 120, 80)
        getgenv().AntiFling = true
    else
        TweenService:Create(AntiFlingIndic, TweenInfo.new(0.15), {
            Position = UDim2.new(0, 2, 0.5, -10),
            BackgroundColor3 = Color3.fromRGB(140, 140, 145)
        }):Play()
        AntiFlingToggle.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        getgenv().AntiFling = false
    end
end

AntiFlingToggle.MouseButton1Click:Connect(function()
    AntiFlingLigado = not AntiFlingLigado
    AtualizarAntiFlingToggle()
end)

