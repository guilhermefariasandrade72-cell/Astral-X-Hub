--==================================================
-- 13. BOTÕES ESP
--==================================================

local function CreateToggleESP(Page, Title, Var, CallbackOn, CallbackOff)
    local Container = Instance.new("Frame")
    Container.Name = Title .. "Container"
    Container.Size = UDim2.new(1, -6, 0, 40)
    Container.BackgroundColor3 = ButtonColor
    Container.BackgroundTransparency = 0.15
    Container.BorderSizePixel = 0
    Container.ZIndex = 6
    Container.Parent = Page
    Round(Container, 9)
    AddStroke(Container, 0.65, 1)
    
    local Label = Instance.new("TextLabel")
    Label.Name = "Label"
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 12, 0, 0)
    Label.Size = UDim2.new(1, -55, 1, 0)
    Label.Text = Title
    Label.TextColor3 = White
    Label.TextSize = 13
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Container
    
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Name = "Toggle"
    ToggleBtn.Size = UDim2.fromOffset(32, 26)
    ToggleBtn.Position = UDim2.new(1, -40, 0.5, -13)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    ToggleBtn.BorderSizePixel = 0
    ToggleBtn.Text = ""
    ToggleBtn.AutoButtonColor = false
    ToggleBtn.ZIndex = 7
    ToggleBtn.Parent = Container
    Round(ToggleBtn, 7)
    
    local Indicator = Instance.new("Frame")
    Indicator.Name = "Indicator"
    Indicator.Size = UDim2.fromOffset(20, 20)
    Indicator.Position = UDim2.new(0, 2, 0.5, -10)
    Indicator.BackgroundColor3 = Color3.fromRGB(140, 140, 145)
    Indicator.BorderSizePixel = 0
    Indicator.ZIndex = 8
    Indicator.Parent = ToggleBtn
    Round(Indicator, 5)
    
    local Ativo = false
    local TweenService = game:GetService("TweenService")
    
    local function Atualizar()
        if Ativo then
            TweenService:Create(Indicator, TweenInfo.new(0.15), {
                Position = UDim2.new(1, -22, 0.5, -10),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            }):Play()
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 120, 80)
            if CallbackOn then CallbackOn() end
        else
            TweenService:Create(Indicator, TweenInfo.new(0.15), {
                Position = UDim2.new(0, 2, 0.5, -10),
                BackgroundColor3 = Color3.fromRGB(140, 140, 145)
            }):Play()
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
            if CallbackOff then CallbackOff() end
        end
    end
    
    ToggleBtn.MouseButton1Click:Connect(function()
        Ativo = not Ativo
        _G[Var] = Ativo
        Atualizar()
    end)
    
    return Container
end

CreateToggleESP(
    Pages["ESP"],
    "Highlight ESP",
    "ESPHighlightAtivo",
    function()
        ESPHighlightAtivo = true
    end,
    function()
        ESPHighlightAtivo = false
        for _, h in pairs(Highlights) do
            if h then h.Enabled = false end
        end
    end
)

CreateToggleESP(
    Pages["ESP"],
    "Name ESP",
    "ESPNomeAtivo",
    function()
        ESPNomeAtivo = true
    end,
    function()
        ESPNomeAtivo = false
        for _, n in pairs(NamesESP) do
            if n and n.Gui then n.Gui.Enabled = false end
        end
    end
)

CreateToggleESP(
    Pages["ESP"],
    "Distance ESP",
    "ESPDistanciaAtiva",
    function()
        ESPDistanciaAtiva = true
    end,
    function()
        ESPDistanciaAtiva = false
    end
)

CreateToggleESP(
    Pages["ESP"],
    "Tracer ESP",
    "ESPTracerAtivo",
    function()
        ESPTracerAtivo = true
    end,
    function()
        ESPTracerAtivo = false
        for _, t in pairs(TracersESP) do
            if t then t.Visible = false end
        end
    end
)

CreateToggleESP(
    Pages["ESP"],
    "X-Ray",
    "XRayAtivo",
    function()
        AtivarXRay()
    end,
    function()
        RemoverXRay()
    end
)

CreateToggleESP(
    Pages["ESP"],
    "Highlight Coins",
    "MoedasHighlightAtivo",
    function()
        MoedasHighlightAtivo = true
        DestacarMoedas()
    end,
    function()
        MoedasHighlightAtivo = false
        RemoverDestaqueMoedas()
    end
)



