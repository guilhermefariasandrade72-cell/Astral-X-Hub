local SliderTexto = Instance.new("TextLabel")
SliderTexto.Name = "Texto"
SliderTexto.BackgroundTransparency = 1
SliderTexto.Position = UDim2.new(0, 12, 0, 8)
SliderTexto.Size = UDim2.new(1, -12, 0, 20)
SliderTexto.Text = "Velocidade: " .. VelocidadeFarmAtual
SliderTexto.TextColor3 = Color3.fromRGB(255, 255, 255)
SliderTexto.TextSize = 13
SliderTexto.Font = Enum.Font.GothamMedium
SliderTexto.TextXAlignment = Enum.TextXAlignment.Left
SliderTexto.Parent = SliderContainer

local BarraFundo = Instance.new("Frame")
BarraFundo.Name = "Fundo"
BarraFundo.Size = UDim2.new(1, -24, 0, 8)
BarraFundo.Position = UDim2.new(0, 12, 0, 42)
BarraFundo.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
BarraFundo.Parent = SliderContainer
Round(BarraFundo, 4)

local BarraProgresso = Instance.new("Frame")
BarraProgresso.Name = "Progresso"
BarraProgresso.Size = UDim2.new((VelocidadeFarmAtual - 16) / 9, 0, 1, 0)
BarraProgresso.BackgroundColor3 = Color3.fromRGB(90, 190, 120)
BarraProgresso.Parent = BarraFundo
Round(BarraProgresso, 4)

local BotaoSlider = Instance.new("TextButton")
BotaoSlider.Name = "Botao"
BotaoSlider.Size = UDim2.fromOffset(22, 22)
BotaoSlider.Position = UDim2.new((VelocidadeFarmAtual - 16) / 9, -11, 0.5, -11)
BotaoSlider.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
BotaoSlider.BorderSizePixel = 0
BotaoSlider.Text = ""
BotaoSlider.AutoButtonColor = false
BotaoSlider.ZIndex = 10
BotaoSlider.Parent = BarraFundo
Round(BotaoSlider, 11)

local UserInputService = game:GetService("UserInputService")
local Arrastando = false

local function AtualizarSlider(X)
    local AbsPos = BarraFundo.AbsolutePosition
    local AbsSize = BarraFundo.AbsoluteSize.X
    local PosX = math.clamp(X - AbsPos.X, 0, AbsSize)
    local Valor = 16 + (PosX / AbsSize) * 9
    Valor = math.floor(Valor + 0.5)
    
    VelocidadeFarmAtual = Valor
    CONFIG_FARM.velocidade = Valor
    
    SliderTexto.Text = "Velocidade: " .. Valor
    BarraProgresso.Size = UDim2.new(PosX / AbsSize, 0, 1, 0)
    BotaoSlider.Position = UDim2.new(PosX / AbsSize, -11, 0.5, -11)
end

-- ✅ MELHOR DETECÇÃO DE TOQUE — FUNCIONA NO MOBILE!
BotaoSlider.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
        Arrastando = true
    end
end)

BarraFundo.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
        Arrastando = true
        AtualizarSlider(Input.Position.X)
    end
end)

UserInputService.InputEnded:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
        Arrastando = false
    end
end)

UserInputService.InputChanged:Connect(function(Input)
    if Arrastando then
        if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
            AtualizarSlider(Input.Position.X)
        end
    end
end)

--==================================================
-- 13. BOTÕES ESP
--==================================================
local function CreateToggleESP(Page, Title, Var, CallbackOn, CallbackOff)
    local Container = Instance.new("Frame")
    Container.Name = Title .. "Container"
    Container.Size = UDim2.new(1, -6, 0, 40)
    Container.BackgroundColor3 = ButtonColor
    Container.BackgroundTransparency = 0.15
    Container.BorderSizePixel = 0
    Container.ZIndex = 6
    Container.Parent = Page
    Round(Container, 9)
    AddStroke(Container, 0.65, 1)
    
    local Label = Instance.new("TextLabel")
    Label.Name = "Label"
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 12, 0, 0)
    Label.Size = UDim2.new(1, -55, 1, 0)
    Label.Text = Title
    Label.TextColor3 = White
    Label.TextSize = 13
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Container
    
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Name = "Toggle"
    ToggleBtn.Size = UDim2.fromOffset(32, 26)
    ToggleBtn.Position = UDim2.new(1, -40, 0.5, -13)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    ToggleBtn.BorderSizePixel = 0
    ToggleBtn.Text = ""
    ToggleBtn.AutoButtonColor = false
    ToggleBtn.ZIndex = 7
    ToggleBtn.Parent = Container
    Round(ToggleBtn, 7)
    
    local Indicator = Instance.new("Frame")
    Indicator.Name = "Indicator"
    Indicator.Size = UDim2.fromOffset(20, 20)
    Indicator.Position = UDim2.new(0, 2, 0.5, -10)
    Indicator.BackgroundColor3 = Color3.fromRGB(140, 140, 145)
    Indicator.BorderSizePixel = 0
    Indicator.ZIndex = 8
    Indicator.Parent = ToggleBtn
    Round(Indicator, 5)
    
    local Ativo = false
    local TweenService = game:GetService("TweenService")
    
    local function Atualizar()
        if Ativo then
            TweenService:Create(Indicator, TweenInfo.new(0.15), {
                Position = UDim2.new(1, -22, 0.5, -10),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            }):Play()
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 120, 80)
            if CallbackOn then CallbackOn() end
        else
            TweenService:Create(Indicator, TweenInfo.new(0.15), {
                Position = UDim2.new(0, 2, 0.5, -10),
                BackgroundColor3 = Color3.fromRGB(140, 140, 145)
            }):Play()
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
            if CallbackOff then CallbackOff() end
        end
    end
    
    ToggleBtn.MouseButton1Click:Connect(function()
        Ativo = not Ativo
        _G[Var] = Ativo
        Atualizar()
    end)
    
    return Container
end

CreateToggleESP(
    Pages["ESP"],
    "Highlight ESP",
    "ESPHighlightAtivo",
    function()
        ESPHighlightAtivo = true
    end,
    function()
        ESPHighlightAtivo = false
        for _, h in pairs(Highlights) do
            if h then h.Enabled = false end
        end
    end
)

CreateToggleESP(
    Pages["ESP"],
    "Name ESP",
    "ESPNomeAtivo",
    function()
        ESPNomeAtivo = true
    end,
    function()
        ESPNomeAtivo = false
        for _, n in pairs(NamesESP) do
            if n and n.Gui then n.Gui.Enabled = false end
        end
    end
)

CreateToggleESP(
    Pages["ESP"],
    "Distance ESP",
    "ESPDistanciaAtiva",
    function()
        ESPDistanciaAtiva = true
    end,
    function()
        ESPDistanciaAtiva = false
    end
)

CreateToggleESP(
    Pages["ESP"],
    "Tracer ESP",
    "ESPTracerAtivo",
    function()
        ESPTracerAtivo = true
    end,
    function()
        ESPTracerAtivo = false
        for _, t in pairs(TracersESP) do
            if t then t.Visible = false end
        end
    end
)

CreateToggleESP(
    Pages["ESP"],
    "X-Ray",
    "XRayAtivo",
    function()
        AtivarXRay()
    end,
    function()
        RemoverXRay()
    end
)

CreateToggleESP(
    Pages["ESP"],
    "Highlight Coins",
    "MoedasHighlightAtivo",
    function()
        MoedasHighlightAtivo = true
        DestacarMoedas()
    end,
    function()
        MoedasHighlightAtivo = false
        RemoverDestaqueMoedas()
    end
)

