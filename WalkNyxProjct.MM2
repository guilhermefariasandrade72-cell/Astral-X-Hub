            15
        )

    ConfirmFrame.BorderSizePixel =
        0

    ConfirmFrame.ZIndex =
        100

    ConfirmFrame.Parent =
        ScreenGui

    Round(
        ConfirmFrame,
        14
    )

    AddStroke(
        ConfirmFrame,
        0.15,
        1.5
    )


    --==================================================
    -- TEXTO DA CONFIRMAÇÃO
    --==================================================

    local Text =
        Instance.new("TextLabel")

    Text.BackgroundTransparency =
        1

    Text.Position =
        UDim2.fromOffset(
            15,
            15
        )

    Text.Size =
        UDim2.new(
            1,
            -30,
            0,
            45
        )

    Text.Text =
        "Deseja fechar o Walk Nyx Project?"

    Text.TextColor3 =
        White

    Text.TextSize =
        14

    Text.Font =
        Enum.Font.GothamMedium

    Text.TextWrapped =
        true

    Text.ZIndex =
        101

    Text.Parent =
        ConfirmFrame


    --==================================================
    -- BOTÃO SIM
    --==================================================

    local Yes =
        Instance.new("TextButton")

    Yes.Size =
        UDim2.fromOffset(
            105,
            35
        )

    Yes.Position =
        UDim2.fromOffset(
            25,
            82
        )

    Yes.BackgroundColor3 =
        White

    Yes.BorderSizePixel =
        0

    Yes.Text =
        "Sim"

    Yes.TextColor3 =
        Color3.fromRGB(
            0,
            0,
            0
        )

    Yes.TextSize =
        13

    Yes.Font =
        Enum.Font.GothamBold

    Yes.ZIndex =
        101

    Yes.Parent =
        ConfirmFrame

    Round(
        Yes,
        9
    )


    --==================================================
    -- BOTÃO NÃO
    --==================================================

    local No =
        Instance.new("TextButton")

    No.Size =
        UDim2.fromOffset(
            105,
            35
        )

    No.Position =
        UDim2.fromOffset(
            140,
            82
        )

    No.BackgroundColor3 =
        ButtonColor

    No.BorderSizePixel =
        0

    No.Text =
        "Não"

    No.TextColor3 =
        White

    No.TextSize =
        13

    No.Font =
        Enum.Font.GothamBold

    No.ZIndex =
        101

    No.Parent =
        ConfirmFrame

    Round(
        No,
        9
    )

    AddStroke(
        No,
        0.45,
        1
    )


    --==================================================
    -- AÇÃO SIM
    --==================================================

    Yes.MouseButton1Click:Connect(function()

        ScreenGui:Destroy()

    end)


    --==================================================
    -- AÇÃO NÃO
    --==================================================

    No.MouseButton1Click:Connect(function()

        ConfirmFrame:Destroy()

        ConfirmFrame =
            nil

    end)

end


--==================================================
-- X -> CONFIRMAÇÃO
