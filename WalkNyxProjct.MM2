local ConfirmFrame


local function CreateConfirmation()

    if ConfirmFrame then
        return
    end


    ConfirmFrame =
        Instance.new("Frame")

    ConfirmFrame.Size =
        UDim2.fromOffset(
            270,
            135
        )

    ConfirmFrame.Position =
        UDim2.new(
            0.5,
            -135,
            0.5,
            -67
        )

    ConfirmFrame.BackgroundColor3 =
        Color3.fromRGB(
            12,
