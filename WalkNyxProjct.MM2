-- Slider Pulo (50 a 100)
local JumpSliderContainer = Instance.new("Frame")
JumpSliderContainer.Name = "SliderPulo"
JumpSliderContainer.Size = UDim2.new(1, -12, 0, 60)
JumpSliderContainer.Position = UDim2.new(0, 6, 0, 45)
JumpSliderContainer.BackgroundTransparency = 1
JumpSliderContainer.Parent = Sec_Jump

local JumpSliderTexto = Instance.new("TextLabel")
JumpSliderTexto.Name = "Texto"
JumpSliderTexto.BackgroundTransparency = 1
JumpSliderTexto.Position = UDim2.new(0, 6, 0, 0)
JumpSliderTexto.Size = UDim2.new(1, 0, 0, 20)
JumpSliderTexto.Text = "Força do Pulo: " .. JumpValor
JumpSliderTexto.TextColor3 = White
JumpSliderTexto.TextSize = 12
JumpSliderTexto.Font = Enum.Font.GothamMedium
JumpSliderTexto.TextXAlignment = Enum.TextXAlignment.Left
JumpSliderTexto.Parent = JumpSliderContainer

local JumpBarraFundo = Instance.new("Frame")
JumpBarraFundo.Name = "Fundo"
JumpBarraFundo.Size = UDim2.new(1, -12, 0, 8)
JumpBarraFundo.Position = UDim2.new(0, 6, 0, 28)
JumpBarraFundo.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
JumpBarraFundo.Parent = JumpSliderContainer
Round(JumpBarraFundo, 4)

local JumpBarraProg = Instance.new("Frame")
JumpBarraProg.Name = "Progresso"
JumpBarraProg.Size = UDim2.new((JumpValor - 50) / 50, 0, 1, 0)
JumpBarraProg.BackgroundColor3 = Color3.fromRGB(90, 190, 120)
JumpBarraProg.Parent = JumpBarraFundo
Round(JumpBarraProg, 4)

local JumpSliderBtn = Instance.new("TextButton")
JumpSliderBtn.Name = "Botao"
JumpSliderBtn.Size = UDim2.fromOffset(22, 22)
JumpSliderBtn.Position = UDim2.new((JumpValor - 50) / 50, -11, 0.5, -11)
JumpSliderBtn.BackgroundColor3 = White
JumpSliderBtn.BorderSizePixel = 0
JumpSliderBtn.Text = ""
JumpSliderBtn.AutoButtonColor = false
JumpSliderBtn.ZIndex = 10
JumpSliderBtn.Parent = JumpBarraFundo
Round(JumpSliderBtn, 11)

local JumpArrastando = false

local function AtualizarJumpSlider(X)
    local AbsPos = JumpBarraFundo.AbsolutePosition
    local AbsSize = JumpBarraFundo.AbsoluteSize.X
    local PosX = math.clamp(X - AbsPos.X, 0, AbsSize)
    local Valor = 50 + (PosX / AbsSize) * 50
    Valor = math.floor(Valor + 0.5)
    
    JumpValor = Valor
    
    JumpSliderTexto.Text = "Força do Pulo: " .. Valor
    JumpBarraProg.Size = UDim2.new(PosX / AbsSize, 0, 1, 0)
    JumpSliderBtn.Position = UDim2.new(PosX / AbsSize, -11, 0.5, -11)
end

JumpSliderBtn.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
        JumpArrastando = true
    end
end)
JumpBarraFundo.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
        JumpArrastando = true
        AtualizarJumpSlider(Input.Position.X)
    end
end)
UserInputService.InputEnded:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
        JumpArrastando = false
    end
end)
UserInputService.InputChanged:Connect(function(Input)
    if JumpArrastando then
        if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
            AtualizarJumpSlider(Input.Position.X)
        end
    end
end)

