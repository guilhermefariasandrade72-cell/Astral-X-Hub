    FloatingButton,
    0.15,
    1.5
)


--==================================================
-- ABRIR / FECHAR NYX
--==================================================

FloatingButton.MouseButton1Click:Connect(function()

    Main.Visible =
        not Main.Visible

end)


--==================================================
-- ARRASTAR BOTÃO NYX
--==================================================

local DraggingNyx =
    false

local NyxDragStart
local NyxStartPosition


FloatingButton.InputBegan:Connect(function(Input)

    if Input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or Input.UserInputType ==
        Enum.UserInputType.Touch then

        DraggingNyx =
            true

        NyxDragStart =
            Input.Position

        NyxStartPosition =
            FloatingButton.Position


        Input.Changed:Connect(function()

            if Input.UserInputState ==
                Enum.UserInputState.End then

                DraggingNyx =
                    false

            end

        end)

    end

end)


UserInputService.InputChanged:Connect(function(Input)

    if not DraggingNyx then
        return
    end

    if Input.UserInputType ==
        Enum.UserInputType.MouseMovement
        or Input.UserInputType ==
        Enum.UserInputType.Touch then

        local Delta =
            Input.Position -
            NyxDragStart

        FloatingButton.Position =
            UDim2.new(

                NyxStartPosition.X.Scale,

                NyxStartPosition.X.Offset
                    + Delta.X,

                NyxStartPosition.Y.Scale,

                NyxStartPosition.Y.Offset
                    + Delta.Y

            )

    end

end)


--==================================================
-- 17. ARRASTAR / MINIMIZAR / FECHAR
--==================================================


--==================================================
-- ARRASTAR JANELA PRINCIPAL
--==================================================

local DraggingWindow =
    false

local WindowDragStart
local WindowStartPosition


TopBar.InputBegan:Connect(function(Input)

    if Input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or Input.UserInputType ==
        Enum.UserInputType.Touch then

        DraggingWindow =
            true

        WindowDragStart =
            Input.Position

        WindowStartPosition =
            Main.Position


        Input.Changed:Connect(function()

            if Input.UserInputState ==
                Enum.UserInputState.End then

                DraggingWindow =
                    false

            end

        end)

    end

end)


UserInputService.InputChanged:Connect(function(Input)

    if not DraggingWindow then
        return
    end

    if Input.UserInputType ==
        Enum.UserInputType.MouseMovement
        or Input.UserInputType ==
        Enum.UserInputType.Touch then

        local Delta =
            Input.Position -
            WindowDragStart

        Main.Position =
            UDim2.new(

                WindowStartPosition.X.Scale,

                WindowStartPosition.X.Offset
                    + Delta.X,

                WindowStartPosition.Y.Scale,

                WindowStartPosition.Y.Offset
                    + Delta.Y

            )

    end

end)


--==================================================
-- MINIMIZAR
--==================================================

local Minimized =
    false


Minimize.MouseButton1Click:Connect(function()

    Minimized =
        not Minimized


    if Minimized then

        Content.Visible =
            false

        Main.Size =
            UDim2.fromOffset(
                WINDOW_WIDTH,
                52
            )

    else

        Main.Size =
            UDim2.fromOffset(
                WINDOW_WIDTH,
                WINDOW_HEIGHT
            )

        Content.Visible =
            true

    end

end)


