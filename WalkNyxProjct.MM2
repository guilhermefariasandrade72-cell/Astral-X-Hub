-- ==================================
-- 💰 SISTEMA DO AUTO FARM
-- ==================================
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- ✅ DETECTA O MURDERER
local function ObterMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local char = p.Character
            local hum = char:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local temFaca = char:FindFirstChild("Knife") or (p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild("Knife"))
                local eMurder = p:GetAttribute("Role") == "Murderer" or temFaca
                if eMurder then return char end
            end
        end
    end
    return nil
end

-- ✅ RESETA AO INICIAR NOVA RODADA
local function ResetarEstadoFarm()
    BolsaCheia = false
    table.clear(collectedCoins)
    table.clear(moedasIgnoradasInvisivel)
    cachedCoinContainer = nil
end
player.CharacterAdded:Connect(ResetarEstadoFarm)
player:GetAttributeChangedSignal("Alive"):Connect(function()
    if player:GetAttribute("Alive") == true then ResetarEstadoFarm() end
end)

-- ✅ VERIFICA SE A BOLSA ESTÁ CHEIA
local function VerificarTextoBolsaCheia()
    local agora = os.clock()
    if agora - ultimoCheckBolsa < 0.5 then return resultadoUltimoCheckBolsa end
    ultimoCheckBolsa = agora
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    local mainGui = playerGui:FindFirstChild("MainGUI") or playerGui:FindFirstChild("GUI")
    if not mainGui then return false end
    for _, gui in ipairs(mainGui:GetDescendants()) do
        if gui:IsA("TextLabel") and gui.Visible and gui.Text ~= "" then
            local texto = string.lower(gui.Text)
            if (string.find(texto, "saco") and string.find(texto, "cheio")) or 
               (string.find(texto, "bag") and string.find(texto, "full")) or
               string.find(texto, "full coin") or string.find(texto, "max coins") then
                resultadoUltimoCheckBolsa = true
                return true
            end
        end
    end
    resultadoUltimoCheckBolsa = false
    return false
end

-- ✅ VERIFICA SE ESTÁ EM PARTIDA
local function EmPartida()
    local c = player.Character
    if not c or not c:FindFirstChild("Humanoid") or c.Humanoid.Health <= 0 then return false end
    if not c:FindFirstChild("HumanoidRootPart") then return false end
    local aliveAttr = player:GetAttribute("Alive")
    if aliveAttr ~= nil and aliveAttr == false then return false end
    return true
end

-- ✅ PEGA MOEDA MAIS PRÓXIMA
local function getNearestCoin(minhaPos)
    local melhorMoeda, menorDistancia = nil, math.huge
    if not cachedCoinContainer or not cachedCoinContainer.Parent then
        cachedCoinContainer = Workspace:FindFirstChild("CoinContainer", true)
    end
    if not cachedCoinContainer then return nil end
    local charMurderer = ObterMurderer()
    local hrpMurderer = charMurderer and charMurderer:FindFirstChild("HumanoidRootPart")
    for _, moeda in ipairs(cachedCoinContainer:GetChildren()) do
        if moeda:IsA("BasePart") and moeda.Name == "Coin_Server" 
        and moeda:FindFirstChild("TouchInterest") 
        and not collectedCoins[moeda] 
        and not moeda:GetAttribute("Collected") then
            if hrpMurderer then
                local distMurder = (moeda.Position - hrpMurderer.Position).Magnitude
                if distMurder <= CONFIG_FARM.raio_perigo_murder then continue end
            end
            if moedasIgnoradasInvisivel[moeda] then continue end
            local distancia = (minhaPos - moeda.Position).Magnitude
            if distancia < CONFIG_FARM.alcance_maximo and distancia < menorDistancia then
                menorDistancia = distancia
                melhorMoeda = moeda
            end
        end
    end
    return melhorMoeda
end

-- ✅ LOOP PRINCIPAL DO AUTO FARM
task.spawn(function()
    while true do
        if AutoFarmAtivo then
            local c = player.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if not EmPartida() or not hrp then
                task.wait(0.5)
                continue
            end
            if BolsaCheia or VerificarTextoBolsaCheia() then
                BolsaCheia = true
                task.wait(0.5)
                continue
            end
            local alvo = getNearestCoin(hrp.Position)
            if alvo then
                while AutoFarmAtivo and EmPartida() and alvo and alvo.Parent 
                and not BolsaCheia and not VerificarTextoBolsaCheia()
                and not alvo:GetAttribute("Collected") 
                and not collectedCoins[alvo] do
                    
                    local minhaPosAtual = hrp.Position
                    local moedaMaisPertoAgora = getNearestCoin(minhaPosAtual)
                    if moedaMaisPertoAgora and moedaMaisPertoAgora ~= alvo then
                        alvo = moedaMaisPertoAgora
                    end
                    if not alvo:IsDescendantOf(Workspace) or alvo:GetAttribute("Collected") then break end
                    
                    local posAlvo = alvo.Position
                    local direcao = (posAlvo - minhaPosAtual)
                    local distancia = direcao.Magnitude
                    
                    if distancia <= 0.8 then
                        collectedCoins[alvo] = true
                        break
                    end
                    
                    local velAtual = math.clamp(VelocidadeFarmAtual, 16, 25)
                    local dt = RunService.Heartbeat:Wait()
                    local passo = math.min(velAtual * dt, distancia)
                    local novaPos = minhaPosAtual + (direcao.Unit * passo)
                    hrp.CFrame = CFrame.new(novaPos)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            else
                task.wait(0.2)
            end
        else
            task.wait(0.5)
        end
    end
end)



--==================================================
-- 08. SISTEMAS / FUNÇÕES — ESP
--==================================================
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local function PegarCargos()
    if tick() - UltimaChecagemCargo < 2 then return end
    UltimaChecagemCargo = tick()
    task.spawn(function()
        local R = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
        if not R then return end
        local ok, d = pcall(function() return R:InvokeServer() end)
        if ok and d then DadosCargos = d end
    end)
end

local function CriarHighlight(Alvo, Cor)
    if not Alvo then return end
    local H = Highlights[Alvo]
    if not H or H.Parent ~= Alvo then
        H = Instance.new("Highlight")
        H.Name = "ESP_Highlight"
        H.Adornee = Alvo
        H.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        H.OutlineTransparency = 0
        H.Parent = Alvo
        Highlights[Alvo] = H
    end
    H.FillColor = Cor
    H.OutlineColor = Cor
    H.Enabled = true
end

local function CriarTextESP(Jogador, Cor, TextoExibido)
    local Char = Jogador.Character
    if not Char or not Char:FindFirstChild("Head") then return end
    local Head = Char.Head
    local Data = NamesESP[Jogador]
    if not Data or not Data.Gui or Data.Gui.Parent ~= Head then
        if Data and Data.Gui then Data.Gui:Destroy() end
        local BGui = Instance.new("BillboardGui")
        BGui.Name = "ESP_Text"
        BGui.Adornee = Head
        BGui.Size = UDim2.new(0, 200, 0, 40)
        BGui.StudsOffset = Vector3.new(0, 2.5, 0)
        BGui.AlwaysOnTop = true
        local TextLabel = Instance.new("TextLabel")
        TextLabel.Name = "Label"
        TextLabel.Size = UDim2.new(1, 0, 1, 0)
        TextLabel.BackgroundTransparency = 1
        TextLabel.Font = Enum.Font.SourceSansBold
        TextLabel.TextSize = 13
        TextLabel.TextStrokeTransparency = 0
        TextLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        TextLabel.Parent = BGui
        BGui.Parent = Head
        Data = {Gui = BGui, Label = TextLabel}
        NamesESP[Jogador] = Data
    end
    Data.Label.Text = TextoExibido
    Data.Label.TextColor3 = Cor
    Data.Gui.Enabled = true
end

local function LimparJogadorESP(p)
    if p and p.Character and Highlights[p.Character] then
        Highlights[p.Character]:Destroy()
        Highlights[p.Character] = nil
    end
    if p and NamesESP[p] then
        if NamesESP[p].Gui then NamesESP[p].Gui:Destroy() end
        NamesESP[p] = nil
    end
    if p and TracersESP[p] then
        TracersESP[p].Visible = false
        TracersESP[p]:Remove()
        TracersESP[p] = nil
    end
end

local function LimparTabela(Tabela)
    for key, item in pairs(Tabela) do
        if typeof(item) == "Instance" then item:Destroy()
        elseif type(item) == "table" and item.Gui then item.Gui:Destroy()
        elseif type(item) == "userdata" and item.Remove then item.Visible = false; item:Remove() end
    end
    table.clear(Tabela)
end

Players.PlayerRemoving:Connect(function(p)
    LimparJogadorESP(p)
end)

RunService.RenderStepped:Connect(function()
    if not ESPTracerAtivo then
        for p, line in pairs(TracersESP) do if line then line.Visible = false end end
        return
    end
    local Cam = Workspace.CurrentCamera
    if not Cam then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player then
            local Char = p.Character
            local Humanoid = Char and Char:FindFirstChildOfClass("Humanoid")
            local HRP = Char and Char:FindFirstChild("HumanoidRootPart")
            if Char and HRP and Humanoid and Humanoid.Health > 0 then
                local Vector, OnScreen = Cam:WorldToViewportPoint(HRP.Position)
                local Line = TracersESP[p]
                if not Line then
                    Line = Drawing.new("Line")
                    Line.Thickness = 1.5
                    Line.Transparency = 0.8
                    TracersESP[p] = Line
                end
                if OnScreen then
                    local Info = DadosCargos[p.Name]
                    local Cor = Color3.fromRGB(255, 255, 255)
                    if Info and not Info.Killed and not Info.Dead then
                        if Info.Role == "Murderer" then Cor = Color3.fromRGB(220, 50, 50)
                        elseif Info.Role == "Sheriff" then Cor = Color3.fromRGB(0, 85, 255)
                        elseif Info.Role == "Hero" then Cor = Color3.fromRGB(255, 215, 0)
                        elseif Info.Role == "Innocent" then Cor = Color3.fromRGB(60, 200, 80) end
                    end
                    Line.From = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y)
                    Line.To = Vector2.new(Vector.X, Vector.Y)
                    Line.Color = Cor
                    Line.Visible = true
                else
                    Line.Visible = false
                end
            else
                if TracersESP[p] then TracersESP[p].Visible = false end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.3)
        if ESPHighlightAtivo or ESPNomeAtivo or ESPDistanciaAtiva or ESPTracerAtivo then
            PegarCargos()
            local MeuChar = Player.Character
            local MinhaPos = (MeuChar and MeuChar:FindFirstChild("HumanoidRootPart")) and MeuChar.HumanoidRootPart.Position or Vector3.new(0,0,0)
            for p, _ in pairs(NamesESP) do
                if not Players:FindFirstChild(p.Name) then LimparJogadorESP(p) end
            end
            for _, p in ipairs(Players:GetPlayers()) do
                local Char = p.Character
                local Humanoid = Char and Char:FindFirstChildOfClass("Humanoid")
                local HRP = Char and Char:FindFirstChild("HumanoidRootPart")
                if p == Player or not Char or not HRP or not Humanoid or Humanoid.Health <= 0 then
                    LimparJogadorESP(p)
                else
                    local Info = DadosCargos[p.Name]
                    local Cor = Color3.fromRGB(255, 255, 255)
                    local CargoNome = "Lobby"
                    if Info and not Info.Killed and not Info.Dead then
                        if Info.Role == "Murderer" then Cor = Color3.fromRGB(220, 50, 50); CargoNome = "Assassino"
                        elseif Info.Role == "Sheriff" then Cor = Color3.fromRGB(0, 85, 255); CargoNome = "Xerife"
                        elseif Info.Role == "Hero" then Cor = Color3.fromRGB(255, 215, 0); CargoNome = "Herói"
                        elseif Info.Role == "Innocent" then Cor = Color3.fromRGB(60, 200, 80); CargoNome = "Inocente" end
                    end
                    local Distancia = math.floor((MinhaPos - HRP.Position).Magnitude)
                    if ESPHighlightAtivo then
                        CriarHighlight(Char, Cor)
                    elseif Highlights[Char] then
                        Highlights[Char].Enabled = false
                    end
                    if ESPNomeAtivo or ESPDistanciaAtiva then
                        local TextoFinal = ""
                        if ESPNomeAtivo and ESPDistanciaAtiva then
                            TextoFinal = p.Name .. " [" .. CargoNome .. "]\n" .. Distancia .. "m"
                        elseif ESPNomeAtivo then
                            TextoFinal = p.Name .. " [" .. CargoNome .. "]"
                        else
                            TextoFinal = Distancia .. "m"
                        end
                        CriarTextESP(p, Cor, TextoFinal)
                    elseif NamesESP[p] and NamesESP[p].Gui then
                        NamesESP[p].Gui.Enabled = false
                    end
                end
            end
        else
            if next(Highlights) then LimparTabela(Highlights) end
            if next(NamesESP) then LimparTabela(NamesESP) end
            if next(TracersESP) then LimparTabela(TracersESP) end
        end
    end
end)

-- ==================================
-- 🧱 SISTEMA DO X-RAY
-- ==================================
local function AplicarXRay()
    for _, Descendente in ipairs(workspace:GetDescendants()) do
        if Descendente:IsA("BasePart") and not Descendente:IsA("Terrain") then
            
            -- ✅ IGNORA PERSONAGENS DE JOGADORES (Muito mais rápido que GetFullName)
            local EhJogador = false
            for _, Jogador in ipairs(Players:GetPlayers()) do
                if Jogador.Character and Descendente:IsDescendantOf(Jogador.Character) then
                    EhJogador = true
                    break
                end
            end
            
            if not EhJogador then
                -- Salva a transparência original apenas se a parte ainda não foi salva
                if ValoresOriginais[Descendente] == nil then
                    ValoresOriginais[Descendente] = Descendente.Transparency
                end

                -- Aplica a transparência
                if Descendente.Transparency < 0.65 then
                    Descendente.Transparency = 0.65
                    Descendente.LocalTransparencyModifier = 0
                end
            end
        end
    end
end

local function AtivarXRay()
    if XRayAtivo then return end
    XRayAtivo = true
    AplicarXRay()
end

local function RemoverXRay()
    if not XRayAtivo then return end
    XRayAtivo = false

    for Parte, TranspOriginal in pairs(ValoresOriginais) do
        if Parte and Parte.Parent then
            Parte.Transparency = TranspOriginal
            Parte.LocalTransparencyModifier = 0
        end
    end
    table.clear(ValoresOriginais)
end

-- 🔄 ATUALIZAÇÃO CONTÍNUA (Mapeia novas partes sem travar o código)
task.spawn(function()
    while true do
        task.wait(0.5)
        if XRayAtivo then
            AplicarXRay()
        end
    end
end)

-- ==================================
-- 💰 SISTEMA DO HIGHLIGHT DE MOEDAS
-- ==================================
local function DestacarMoedas()
    for _, Descendente in ipairs(workspace:GetDescendants()) do
        if Descendente:IsA("BasePart") then
            local Nome = Descendente.Name:lower()
            
            -- Encontra moedas
            if string.find(Nome, "coin") or string.find(Nome, "Coin") then
                if not MoedasDestacadas[Descendente] then
                    local Highlight = Instance.new("Highlight")
                    Highlight.Name = "Moeda_Highlight"
                    Highlight.FillTransparency = 0.3
                    Highlight.OutlineTransparency = 0
                    Highlight.FillColor = Color3.fromRGB(255, 215, 0)  -- 💰 AMARELO
                    Highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
                    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    Highlight.Adornee = Descendente
                    Highlight.Parent = Descendente
                    MoedasDestacadas[Descendente] = Highlight
                end
            end
        end
    end
end

local function RemoverDestaqueMoedas()
    for Parte, Highlight in pairs(MoedasDestacadas) do
        if Highlight and Highlight.Parent then
            Highlight:Destroy()
        end
    end
    table.clear(MoedasDestacadas)
end

-- 🔄 ATUALIZAÇÃO CONTÍNUA
task.spawn(function()
    while true do
        task.wait(0.5)
        if MoedasHighlightAtivo then
            DestacarMoedas()
        end
    end
end)



