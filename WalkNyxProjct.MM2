SpeedIndic.Name = "Indicador"
SpeedIndic.Size = UDim2.fromOffset(20, 20)
SpeedIndic.Position = UDim2.new(0, 2, 0.5, -10)
SpeedIndic.BackgroundColor3 = Color3.fromRGB(140, 140, 145)
SpeedIndic.BorderSizePixel = 0
SpeedIndic.Parent = SpeedToggle
Round(SpeedIndic, 5)

local SpeedLigado = false

local function AtualizarSpeedToggle()
    if SpeedLigado then
        TweenService:Create(SpeedIndic, TweenInfo.new(0.15), {
            Position = UDim2.new(1, -22, 0.5, -10),
            BackgroundColor3 = White
        }):Play()
        SpeedToggle.BackgroundColor3 = Color3.fromRGB(45, 120, 80)
        SpeedAtivo = true
    else
        TweenService:Create(SpeedIndic, TweenInfo.new(0.15), {
            Position = UDim2.new(0, 2, 0.5, -10),
            BackgroundColor3 = Color3.fromRGB(140, 140, 145)
        }):Play()
        SpeedToggle.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        SpeedAtivo = false
    end
end

SpeedToggle.MouseButton1Click:Connect(function()
    SpeedLigado = not SpeedLigado
    AtualizarSpeedToggle()
end)

-- Slider Velocidade (16 a 45)
local SpeedSliderContainer = Instance.new("Frame")
SpeedSliderContainer.Name = "SliderVelocidade"
SpeedSliderContainer.Size = UDim2.new(1, -12, 0, 60)
SpeedSliderContainer.Position = UDim2.new(0, 6, 0, 45)
SpeedSliderContainer.BackgroundTransparency = 1
SpeedSliderContainer.Parent = Sec_Speed

local SpeedSliderTexto = Instance.new("TextLabel")
SpeedSliderTexto.Name = "Texto"
SpeedSliderTexto.BackgroundTransparency = 1
SpeedSliderTexto.Position = UDim2.new(0, 6, 0, 0)
SpeedSliderTexto.Size = UDim2.new(1, 0, 0, 20)
SpeedSliderTexto.Text = "Velocidade: " .. SpeedValor
SpeedSliderTexto.TextColor3 = White
SpeedSliderTexto.TextSize = 12
SpeedSliderTexto.Font = Enum.Font.GothamMedium
SpeedSliderTexto.TextXAlignment = Enum.TextXAlignment.Left
SpeedSliderTexto.Parent = SpeedSliderContainer

local SpeedBarraFundo = Instance.new("Frame")
SpeedBarraFundo.Name = "Fundo"
SpeedBarraFundo.Size = UDim2.new(1, -12, 0, 8)
SpeedBarraFundo.Position = UDim2.new(0, 6, 0, 28)
SpeedBarraFundo.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
SpeedBarraFundo.Parent = SpeedSliderContainer
Round(SpeedBarraFundo, 4)

local SpeedBarraProg = Instance.new("Frame")
SpeedBarraProg.Name = "Progresso"
SpeedBarraProg.Size = UDim2.new((SpeedValor - 16) / 29, 0, 1, 0)
SpeedBarraProg.BackgroundColor3 = Color3.fromRGB(90, 190, 120)
SpeedBarraProg.Parent = SpeedBarraFundo
Round(SpeedBarraProg, 4)

local SpeedSliderBtn = Instance.new("TextButton")
SpeedSliderBtn.Name = "Botao"
SpeedSliderBtn.Size = UDim2.fromOffset(22, 22)
SpeedSliderBtn.Position = UDim2.new((SpeedValor - 16) / 29, -11, 0.5, -11)
SpeedSliderBtn.BackgroundColor3 = White
SpeedSliderBtn.BorderSizePixel = 0
SpeedSliderBtn.Text = ""
SpeedSliderBtn.AutoButtonColor = false
SpeedSliderBtn.ZIndex = 10
SpeedSliderBtn.Parent = SpeedBarraFundo
Round(SpeedSliderBtn, 11)

local SpeedArrastando = false

local function AtualizarSpeedSlider(X)
    local AbsPos = SpeedBarraFundo.AbsolutePosition
    local AbsSize = SpeedBarraFundo.AbsoluteSize.X
    local PosX = math.clamp(X - AbsPos.X, 0, AbsSize)
    local Valor = 16 + (PosX / AbsSize) * 29
    Valor = math.floor(Valor + 0.5)
    
    SpeedValor = Valor
    
    SpeedSliderTexto.Text = "Velocidade: " .. Valor
    SpeedBarraProg.Size = UDim2.new(PosX / AbsSize, 0, 1, 0)
    SpeedSliderBtn.Position = UDim2.new(PosX / AbsSize, -11, 0.5, -11)
end

SpeedSliderBtn.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
        SpeedArrastando = true
    end
end)
SpeedBarraFundo.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
        SpeedArrastando = true
        AtualizarSpeedSlider(Input.Position.X)
    end
end)
UserInputService.InputEnded:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
        SpeedArrastando = false
    end
end)
UserInputService.InputChanged:Connect(function(Input)
    if SpeedArrastando then
        if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
            AtualizarSpeedSlider(Input.Position.X)
        end
    end
end)

