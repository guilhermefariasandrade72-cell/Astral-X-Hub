local function KillAllInstantaneo()
    if not player then return end

    local character = player.Character
    if not character or not character.Parent then return end

    -- Busca a faca na mÃ£o do personagem ou na mochila (Backpack)
    local knife = character:FindFirstChild("Knife")
    if not knife then
        knife = player.Backpack:FindFirstChild("Knife")
        if knife then
            knife.Parent = character
        else
            warn("VocÃª precisa ser o Murderer (possuir a faca) para usar esta funÃ§Ã£o!")
            return
        end
    end

    -- Dispara o evento para TODOS os jogadores ao mesmo tempo sem o task.wait
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Head") then
            task.spawn(function()
                pcall(function()
                    knife.Events.KnifeStabbed:FireServer()
                    knife.Events.HandleTouched:FireServer(targetPlayer.Character.Head)
                end)
            end)
        end
    end
end

