-- ============================================================
-- 🪟 WINDOW
-- ============================================================

local Window = WindUI:CreateWindow({

    Title = gradient(
        "Walker Nyx Project",
        Color3.fromHex("#FFFFFF"),
        Color3.fromHex("#CCCCCC")
    ),

    Icon = "star",

    Author = gradient(
        "Script MM2 Keyless",
        Color3.fromHex("#1BF2B2"),
        Color3.fromHex("#1BCBF2")
    ),

    Size = UDim2.fromOffset(480, 340),

    MinSize = Vector2.new(420, 300),

    Transparent = true,

    Transparency = WindowTransparency,

    Theme = "Astral_Ruby",

    SideBarWidth = 120,

    HasOutline = true,

    HideSearchBar = true,

})

-- ============================================================
-- 🎨 CONFIGURAR WINDOW
-- ============================================================

pcall(function()

    if Window.UIElements then

        if Window.UIElements.Main then

            Window.UIElements.Main.BackgroundColor3 =
                MainColor

            Window.UIElements.Main.BackgroundTransparency =
                WindowTransparency

        end

        if Window.UIElements.SideBar then

            Window.UIElements.SideBar.BackgroundColor3 =
                Color3.fromHex("#141417")

            Window.UIElements.SideBar.BackgroundTransparency =
                WindowTransparency

            Window.UIElements.SideBar.ClipsDescendants =
                true

            local Corner =
                Window.UIElements.SideBar
                :FindFirstChildOfClass("UICorner")

            if Corner then

                Corner.CornerRadius =
                    UDim.new(0, 18)

            else

                Corner =
                    Instance.new("UICorner")

                Corner.CornerRadius =
                    UDim.new(0, 18)

                Corner.Parent =
                    Window.UIElements.SideBar

            end

        end

    elseif Window.Frame then

        Window.Frame.BackgroundColor3 =
            MainColor

        Window.Frame.BackgroundTransparency =
            WindowTransparency

    end

end)

-- ============================================================
-- 🖼️ IMAGEM DE FUNDO
-- ============================================================

pcall(function()

    if not Window.UIElements
        or not Window.UIElements.Main then

        return

    end

    local Main =
        Window.UIElements.Main

    local Background =
        Instance.new("ImageLabel")

    Background.Name =
        "AstralXBackground"

    Background.Size =
        UDim2.new(1, 0, 1, 0)

    Background.Position =
        UDim2.new(0, 0, 0, 0)

    Background.BackgroundTransparency =
        1

    Background.BorderSizePixel =
        0

    Background.Image =
        "rbxassetid://84578192283648"

    Background.ImageTransparency =
        0

    Background.ImageColor3 =
        Color3.fromRGB(255, 255, 255)

    Background.ScaleType =
        Enum.ScaleType.Crop

    local ImageCorner =
        Instance.new("UICorner")

    ImageCorner.Name =
        "AstralXImageCorner"

    ImageCorner.CornerRadius =
        UDim.new(0, 18)

    ImageCorner.Parent =
        Background

    Background.ZIndex =
        1

    Background.Parent =
        Main

end)

