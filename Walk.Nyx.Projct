-- ====================================================
-- SISTEMA DA ABA MURDERER 
-- ====================================================

local function ExecutarAtaque(Alvo)
    local Char = player.Character
    if not Char then return end
    
    local Faca = Char:FindFirstChild("Knife") or (player.Backpack and player.Backpack:FindFirstChild("Knife"))
    if not Faca then return end
    
    if Faca.Parent ~= Char then 
        Faca.Parent = Char 
        task.wait(0.02) 
    end
    
    local Eventos = Faca:FindFirstChild("Events")
    if not Eventos then return end

    if Alvo and Alvo.Character and Alvo.Character:FindFirstChild("Head") then
        pcall(function()
            Eventos.KnifeStabbed:FireServer()
            Eventos.HandleTouched:FireServer(Alvo.Character.Head)
        end)
    end
end

-- Função para o Botão de Clique Instantâneo
local function KillAllInstantaneo()
    for _, Alvo in ipairs(Players:GetPlayers()) do
        if Alvo ~= player and Alvo.Character and Alvo.Character:FindFirstChild("Head") then
            ExecutarAtaque(Alvo)
        end
    end
end

-- Função para o Toggle (Mata 1 por 1 com pequeno intervalo)
local function KillAuraLoop()
    for _, Alvo in ipairs(Players:GetPlayers()) do
        if not KillAura then break end
        if Alvo ~= player and Alvo.Character and Alvo.Character:FindFirstChild("Head") then
            ExecutarAtaque(Alvo)
            task.wait(0.15)
        end
    end
end

-- Loop de execução do Toggle
task.spawn(function()
    while true do
        task.wait(0.3)
        if KillAura then
            KillAuraLoop()
        end
    end
end)

-- ===========================================
-- 🗡️ SISTEMA BOTÃO FLUTUANTE KILL ALL
-- ===========================================

local function CreateKillAllButton()
    if KillAllButtonGui then return end

    local ParentGui = CoreGui
    pcall(function()
        if not CoreGui then
            ParentGui = player:WaitForChild("PlayerGui")
        end
    end)

    local GuiBtn = Instance.new("ScreenGui")
    GuiBtn.Name = "AstralX_KillAllButton"
    GuiBtn.ResetOnSpawn = false
    GuiBtn.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    GuiBtn.Parent = ParentGui

    local Btn = Instance.new("ImageButton")
    Btn.Size = UDim2.new(0, 110, 0, 42)
    Btn.Position = UDim2.new(0.5, -55, 0.7, -21)
    Btn.BackgroundColor3 = Color3.fromRGB(150, 20, 20)
    Btn.BackgroundTransparency = 0.3
    Btn.Parent = GuiBtn

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 10)
    Corner.Parent = Btn

    local Borda = Instance.new("UIStroke")
    Borda.Color = Color3.fromRGB(255, 50, 50)
    Borda.Thickness = 2
    Borda.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Borda.Parent = Btn

    local Texto = Instance.new("TextLabel")
    Texto.Size = UDim2.new(1, 0, 1, 0)
    Texto.BackgroundTransparency = 1
    Texto.Text = "Kill All"
    Texto.TextColor3 = Color3.fromRGB(255, 255, 255)
    Texto.TextSize = 15
    Texto.Font = Enum.Font.GothamBold
    Texto.Parent = Btn

    -- Arrastar o botão na tela
    Btn.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDraggingKill = true
            buttonStartPosKill = Btn.Position
            dragStartPosKill = Input.Position

            Input.Changed:Connect(function()
                if Input.UserInputState == Enum.UserInputState.End then 
                    isDraggingKill = false 
                end
            end)
        end
    end)

    Btn.InputChanged:Connect(function(Input)
        if isDraggingKill and (Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseMovement) then
            Btn.Position = buttonStartPosKill + UDim2.fromOffset(
                Input.Position.X - dragStartPosKill.X,
                Input.Position.Y - dragStartPosKill.Y
            )
        end
    end)

    -- Clique executa o Kill All Instantâneo
    Btn.MouseButton1Click:Connect(function() 
        if not isDraggingKill then 
            KillAllInstantaneo() 
        end 
    end)

    KillAllButtonGui = GuiBtn
end

local function RemoveKillAllButton()
    if KillAllButtonGui then 
        KillAllButtonGui:Destroy() 
        KillAllButtonGui = nil 
    end
end

-- ==================================
-- 🔴 SISTEMA DE KILL AURA + CÍRCULO DINÂMICO
-- =================================

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local KillAuraAtivo = false
local RaioKillAura = 15
local MostrarCirculoAura = false

local CirculoAdornment = nil

-- 📏 CRIAR / ATUALIZAR O CÍRCULO VERMELHO VISUAL
local function AtualizarCirculoAura()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    -- Removido o 'KillAuraAtivo' daqui para dependente apenas do 'MostrarCirculoAura'
    if not MostrarCirculoAura or not hrp then
        if CirculoAdornment then
            CirculoAdornment:Destroy()
            CirculoAdornment = nil
        end
        return
    end

    if not CirculoAdornment or not CirculoAdornment.Parent then
        CirculoAdornment = Instance.new("CylinderHandleAdornment")
        CirculoAdornment.Name = "KillAuraRangeVisual"
        CirculoAdornment.Color3 = Color3.fromRGB(255, 0, 0)
        CirculoAdornment.Transparency = 0.6
        CirculoAdornment.AlwaysOnTop = true
        CirculoAdornment.ZIndex = 5
        CirculoAdornment.CFrame = CFrame.Angles(math.rad(90), 0, 0)
    end

    CirculoAdornment.Adornee = hrp
    CirculoAdornment.Parent = hrp
    CirculoAdornment.Height = 0.2
    CirculoAdornment.Radius = RaioKillAura
end

-- ⚔️ EXECUTAR ATAQUE DE FACA
local function ExecutarAtaque(Alvo)
    local Char = player.Character
    if not Char then return end
    
    local Faca = Char:FindFirstChild("Knife") or (player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Knife"))
    if not Faca then return end
    
    if Faca.Parent ~= Char then 
        Faca.Parent = Char 
        task.wait(0.02) 
    end
    
    local Eventos = Faca:FindFirstChild("Events")
    if not Eventos then return end

    if Alvo and Alvo.Character and Alvo.Character:FindFirstChild("Head") then
        pcall(function()
            Eventos.KnifeStabbed:FireServer()
            Eventos.HandleTouched:FireServer(Alvo.Character.Head)
        end)
    end
end

-- 🔴 LOOP DE ATUALIZAÇÃO DO CÍRCULO
task.spawn(function()
    while true do
        task.wait(0.1)
        AtualizarCirculoAura()
    end
end)

-- ⚔️ LOOP DO KILL AURA
task.spawn(function()
    while true do
        task.wait(0.1)

        if KillAuraAtivo then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if hrp and hum and hum.Health > 0 then
                for _, Alvo in ipairs(Players:GetPlayers()) do
                    if not KillAuraAtivo then break end
                    
                    if Alvo ~= player and Alvo.Character then
                        local alvoHrp = Alvo.Character:FindFirstChild("HumanoidRootPart")
                        local alvoHum = Alvo.Character:FindFirstChildOfClass("Humanoid")
                        
                        if alvoHrp and alvoHum and alvoHum.Health > 0 then
                            local distancia = (hrp.Position - alvoHrp.Position).Magnitude
                            
                            if distancia <= RaioKillAura then
                                ExecutarAtaque(Alvo)
                            end
                        end
                    end
                end
            end
        end
    end
end)

player.CharacterAdded:Connect(function()
    task.wait(1)
    AtualizarCirculoAura()
end)

-- =========================================================
-- 📦 VARIÁVEIS GLOBAIS
-- =========================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local JogadorSelecionado = nil
local ConexaoGrabLocal = nil

-- =========================================================
-- 🧲 FUNÇÃO VISUAL GRAB PLAYER (LOCAL/CLIENTE)
-- =========================================================

local function TrancarJogadorNaFrente()
    if ConexaoGrabLocal then
        ConexaoGrabLocal:Disconnect()
        ConexaoGrabLocal = nil
    end

    if not JogadorSelecionado or JogadorSelecionado == "Nenhum Jogador" then return end

    local targetPlayer = Players:FindFirstChild(JogadorSelecionado)
    if not targetPlayer then return end

    local character = player.Character
    local targetChar = targetPlayer.Character

    if not character or not targetChar then return end

    local myHRP = character:FindFirstChild("HumanoidRootPart")
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")

    if not myHRP or not targetHRP then return end

    ConexaoGrabLocal = RunService.RenderStepped:Connect(function()
        if character and character:FindFirstChild("HumanoidRootPart") and targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
            -- Fixa 2.5 studs na sua frente, virado para você
            local posicaoFrente = myHRP.CFrame * CFrame.new(0, 0, -2.5) * CFrame.Angles(0, math.rad(180), 0)
            targetHRP.CFrame = posicaoFrente
        else
            if ConexaoGrabLocal then
                ConexaoGrabLocal:Disconnect()
                ConexaoGrabLocal = nil
            end
        end
    end)
end

local function SoltarJogador()
    if ConexaoGrabLocal then
        ConexaoGrabLocal:Disconnect()
        ConexaoGrabLocal = nil
    end
end






-- ====================================================
-- SISTEMA DA ABA AUTO FARM
-- ====================================================

local function ObterMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local char = p.Character
            local hum = char:FindFirstChild("Humanoid")

            if hum and hum.Health > 0 then
                local temFaca = char:FindFirstChild("Knife") or (p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild("Knife"))
                local eMurder = p:GetAttribute("Role") == "Murderer" or temFaca

                if eMurder then
                    return char
                end
            end
        end
    end
    return nil
end

local function ResetarEstadoFarm()
    BolsaCheia = false
    table.clear(collectedCoins)
    table.clear(moedasIgnoradasInvisivel)
    cachedCoinContainer = nil
end

player.CharacterAdded:Connect(ResetarEstadoFarm)

player:GetAttributeChangedSignal("Alive"):Connect(function()
    if player:GetAttribute("Alive") == true then
        ResetarEstadoFarm()
    end
end)

task.spawn(function()
    while true do
        task.wait(0.1)
        if AutoFarmAtivo then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local charMurderer = ObterMurderer()
            local hrpMurderer = charMurderer and charMurderer:FindFirstChild("HumanoidRootPart")

            if hrp and hrpMurderer then
                local distMurder = (hrp.Position - hrpMurderer.Position).Magnitude

                if distMurder <= CONFIG_FARM.raio_perigo_murder then
                    if not InvisivelAtivo then
                        InvisivelAtivo = true
                    end
                else
                    if InvisivelAtivo then
                        InvisivelAtivo = false
                    end
                end
            end
        end
    end
end)

local function VerificarTextoBolsaCheia()
    local agora = os.clock()
    if agora - ultimoCheckBolsa < 0.5 then
        return resultadoUltimoCheckBolsa
    end
    ultimoCheckBolsa = agora

    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return false end

    local mainGui = playerGui:FindFirstChild("MainGUI") or playerGui:FindFirstChild("GUI")
    if not mainGui then return false end

    for _, gui in ipairs(mainGui:GetDescendants()) do
        if gui:IsA("TextLabel") and gui.Visible and gui.Text ~= "" then
            local texto = string.lower(gui.Text)
            if (string.find(texto, "saco") and string.find(texto, "cheio")) or
               (string.find(texto, "bag") and string.find(texto, "full")) or
               string.find(texto, "full coin") or string.find(texto, "max coins") then
                resultadoUltimoCheckBolsa = true
                return true
            end
        end
    end

    resultadoUltimoCheckBolsa = false
    return false
end

task.spawn(function()
    local Remotes = ReplicatedStorage:FindFirstChild("Remotes", true) or ReplicatedStorage:FindFirstChild("Gameplay", true)
    if Remotes then
        local coinCollectedRemote = Remotes:FindFirstChild("CoinCollected", true)
        if coinCollectedRemote and coinCollectedRemote:IsA("RemoteEvent") then
            coinCollectedRemote.OnClientEvent:Connect(function(coletador, atual, maximo)
                if coletador == player or (typeof(coletador) == "string" and coletador == player.Name) then
                    if tonumber(atual) and tonumber(maximo) then
                        BolsaCheia = (tonumber(atual) >= tonumber(maximo))
                    end
                end
            end)
        end
    end
end)

local function EmPartida()
    local c = player.Character
    if not c or not c:FindFirstChild("Humanoid") or c.Humanoid.Health <= 0 then return false end
    if not c:FindFirstChild("HumanoidRootPart") then return false end

    local aliveAttr = player:GetAttribute("Alive")
    if aliveAttr ~= nil and aliveAttr == false then
        return false
    end

    if Workspace:FindFirstChild("Lobby") then
        local distLobby = (c.HumanoidRootPart.Position - Workspace.Lobby:GetPivot().Position).Magnitude
        if distLobby < 100 then
            return false
        end
    end

    return true
end

local function getNearestCoin(minhaPos)
    local melhorMoeda, menorDistancia = nil, math.huge

    if not cachedCoinContainer or not cachedCoinContainer.Parent then
        cachedCoinContainer = Workspace:FindFirstChild("CoinContainer", true)
    end

    if not cachedCoinContainer then return nil end

    local charMurderer = ObterMurderer()
    local hrpMurderer = charMurderer and charMurderer:FindFirstChild("HumanoidRootPart")

    for _, moeda in ipairs(cachedCoinContainer:GetChildren()) do
        if moeda:IsA("BasePart")
        and moeda.Name == "Coin_Server"
        and moeda:FindFirstChild("TouchInterest")
        and not collectedCoins[moeda]
        and not moeda:GetAttribute("Collected") then

            if hrpMurderer then
                local distMurder = (moeda.Position - hrpMurderer.Position).Magnitude
                if distMurder <= CONFIG_FARM.raio_perigo_murder then
                    continue
                end
            end

            if moedasIgnoradasInvisivel[moeda] then
                if not InvisivelAtivo then
                    moedasIgnoradasInvisivel[moeda] = nil
                else
                    continue
                end
            end

            local distancia = (minhaPos - moeda.Position).Magnitude
            if distancia < CONFIG_FARM.alcance_maximo and distancia < menorDistancia then
                menorDistancia = distancia
                melhorMoeda = moeda
            end
        end
    end

    return melhorMoeda
end

task.spawn(function()
    while true do
        if AutoFarmAtivo then
            local c = player.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")

            if not EmPartida() or not hrp then
                task.wait(0.5)
                continue
            end

            if BolsaCheia or VerificarTextoBolsaCheia() then
                BolsaCheia = true
                task.wait(0.5)
                continue
            end

            local alvo = getNearestCoin(hrp.Position)

            if alvo then
                local tempoPassadoNaMoeda = 0

                while AutoFarmAtivo and EmPartida() and alvo and alvo.Parent
                and not BolsaCheia and not VerificarTextoBolsaCheia()
                and not alvo:GetAttribute("Collected")
                and not collectedCoins[alvo] do

                    local minhaPosAtual = hrp.Position

                    local moedaMaisPertoAgora = getNearestCoin(minhaPosAtual)
                    if moedaMaisPertoAgora and moedaMaisPertoAgora ~= alvo then
                        alvo = moedaMaisPertoAgora
                        tempoPassadoNaMoeda = 0
                    end

                    if not alvo:IsDescendantOf(Workspace) or alvo:GetAttribute("Collected") then
                        break
                    end

                    local posAlvo = alvo.Position
                    local direcao = (posAlvo - minhaPosAtual)
                    local distancia = direcao.Magnitude

                    if distancia <= 0.8 then
                        if InvisivelAtivo then
                            moedasIgnoradasInvisivel[alvo] = true
                            break
                        else
                            collectedCoins[alvo] = true
                            break
                        end
                    end

                    local velAtual = math.clamp(CONFIG_FARM.velocidade, 16, 20)
                    local dt = RunService.Heartbeat:Wait()
                    local passo = math.min(velAtual * dt, distancia)
                    local novaPos = minhaPosAtual + (direcao.Unit * passo)

                    hrp.CFrame = CFrame.new(novaPos)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

                    tempoPassadoNaMoeda = tempoPassadoNaMoeda + dt
                    if tempoPassadoNaMoeda > 1.5 and InvisivelAtivo then
                        moedasIgnoradasInvisivel[alvo] = true
                        break
                    end
                end
            else
                task.wait(0.2)
            end
        else
            task.wait(0.5)
        end
    end
end)

-- ==================================
-- SISTEMAS DA ABA ESP (OPTIMIZADO PARA MOBILE)
-- ==================================
local UltimaChecagemCargo = 0

local function PegarCargos()
    if tick() - UltimaChecagemCargo < 2 then return end
    UltimaChecagemCargo = tick()

    task.spawn(function()
        local R = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
        if not R then return end
        local ok, d = pcall(function() return R:InvokeServer() end)
        if ok and d then DadosCargos = d end
    end)
end

-- 🔴 HIGHLIGHT REUTILIZÁVEL
local function CriarHighlight(Alvo, Cor)
    if not Alvo then return end
    local H = Highlights[Alvo]
    if not H or H.Parent ~= Alvo then
        H = Instance.new("Highlight")
        H.Name = "ESP_Highlight"
        H.Adornee = Alvo
        H.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        H.OutlineTransparency = 0
        H.Parent = Alvo
        Highlights[Alvo] = H
    end
    H.FillColor = Cor
    H.OutlineColor = Cor
    H.Enabled = true
end

-- 🟢 NOME E DISTÂNCIA EM UMA ÚNICA BILLBOARD
local function CriarTextESP(Jogador, Cor, TextoExibido)
    local Char = Jogador.Character
    if not Char or not Char:FindFirstChild("Head") then return end
    local Head = Char.Head

    local Data = NamesESP[Jogador]
    if not Data or not Data.Gui or Data.Gui.Parent ~= Head then
        if Data and Data.Gui then Data.Gui:Destroy() end
        
        local BGui = Instance.new("BillboardGui")
        BGui.Name = "ESP_Text"
        BGui.Adornee = Head
        BGui.Size = UDim2.new(0, 200, 0, 40)
        BGui.StudsOffset = Vector3.new(0, 2.5, 0)
        BGui.AlwaysOnTop = true

        local TextLabel = Instance.new("TextLabel")
        TextLabel.Name = "Label"
        TextLabel.Size = UDim2.new(1, 0, 1, 0)
        TextLabel.BackgroundTransparency = 1
        TextLabel.Font = Enum.Font.SourceSansBold
        TextLabel.TextSize = 13
        TextLabel.TextStrokeTransparency = 0
        TextLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        TextLabel.Parent = BGui

        BGui.Parent = Head
        Data = {Gui = BGui, Label = TextLabel}
        NamesESP[Jogador] = Data
    end

    Data.Label.Text = TextoExibido
    Data.Label.TextColor3 = Cor
    Data.Gui.Enabled = true
end

-- 🧹 LIMPEZA COMPLETA DE UM JOGADOR
local function LimparJogadorESP(p)
    if p and p.Character and Highlights[p.Character] then
        Highlights[p.Character]:Destroy()
        Highlights[p.Character] = nil
    end
    if p and NamesESP[p] then
        if NamesESP[p].Gui then NamesESP[p].Gui:Destroy() end
        NamesESP[p] = nil
    end
    if p and TracersESP[p] then
        TracersESP[p].Visible = false
        TracersESP[p]:Remove()
        TracersESP[p] = nil
    end
end

-- 🧹 LIMPEZA GERAL
local function LimparTabela(Tabela)
    for key, item in pairs(Tabela) do
        if typeof(item) == "Instance" then
            item:Destroy()
        elseif type(item) == "table" and item.Gui then
            item.Gui:Destroy()
        elseif type(item) == "userdata" and item.Remove then
            item.Visible = false
            item:Remove()
        end
    end
    table.clear(Tabela)
end

-- 📌 EVENTOS DE REMOÇÃO INSTANTÂNEA (Sem esperar o loop)
Players.PlayerRemoving:Connect(function(p)
    LimparJogadorESP(p)
end)

-- 🟡 LOOP EXCLUSIVO PARA LINHAS/TRACERS (Roda todo quadro sem lag visual)
RunService.RenderStepped:Connect(function()
    if not ESPTracerAtivo then
        for p, line in pairs(TracersESP) do
            if line then line.Visible = false end
        end
        return
    end

    local Cam = Workspace.CurrentCamera
    if not Cam then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local Char = p.Character
            local Humanoid = Char and Char:FindFirstChildOfClass("Humanoid")
            local HRP = Char and Char:FindFirstChild("HumanoidRootPart")

            if Char and HRP and Humanoid and Humanoid.Health > 0 then
                local Vector, OnScreen = Cam:WorldToViewportPoint(HRP.Position)

                local Line = TracersESP[p]
                if not Line then
                    Line = Drawing.new("Line")
                    Line.Thickness = 1.5
                    Line.Transparency = 0.8
                    TracersESP[p] = Line
                end

                if OnScreen then
                    local Info = DadosCargos[p.Name]
                    local Cor = Color3.fromRGB(255, 255, 255)
                    if Info and not Info.Killed and not Info.Dead then
                        if Info.Role == "Murderer" then Cor = Color3.fromRGB(220, 50, 50)
                        elseif Info.Role == "Sheriff" then Cor = Color3.fromRGB(0, 85, 255)
                        elseif Info.Role == "Hero" then Cor = Color3.fromRGB(255, 215, 0)
                        elseif Info.Role == "Innocent" then Cor = Color3.fromRGB(60, 200, 80) end
                    end

                    Line.From = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y)
                    Line.To = Vector2.new(Vector.X, Vector.Y)
                    Line.Color = Cor
                    Line.Visible = true
                else
                    Line.Visible = false
                end
            else
                if TracersESP[p] then
                    TracersESP[p].Visible = false
                end
            end
        end
    end
end)

