-- 🎨 REGISTRAR TEMAS
-- ============================================================

for Nome, Cor in pairs(CoresAstral) do

    WindUI:AddTheme({

        Name = "Astral_" .. Nome,

        Background = "#18181B",

        Accent = Cor.Accent,
        Button = Cor.Button,
        Icon = Cor.Icon,

        Text = "#FFFFFF",
        Placeholder = "#888888",
        Outline = "#303036",

    })

end

