-- ==================================
-- 🗡️ SISTEMA DE ATAQUE
-- ==================================
local function ExecutarAtaque(Alvo)
    local Char = player.Character
    if not Char then return end
    
    local Faca = Char:FindFirstChild("Knife") or (player.Backpack and player.Backpack:FindFirstChild("Knife"))
    if not Faca then return end
    
    if Faca.Parent ~= Char then 
        Faca.Parent = Char 
        task.wait(0.02) 
    end
    
    local Eventos = Faca:FindFirstChild("Events")
    if not Eventos then return end
    if Alvo and Alvo.Character and Alvo.Character:FindFirstChild("Head") then
        pcall(function()
            Eventos.KnifeStabbed:FireServer()
            Eventos.HandleTouched:FireServer(Alvo.Character.Head)
        end)
    end
end

-- ==================================
-- 🗡️ SISTEMA KILL ALL INSTANTÂNEO
-- ==================================
local function KillAllInstantaneo()
    for _, Alvo in ipairs(Players:GetPlayers()) do
        if Alvo ~= player and Alvo.Character and Alvo.Character:FindFirstChild("Head") then
            ExecutarAtaque(Alvo)
        end
    end
end

-- ==================================
-- ⚔️ SISTEMA KILL AURA LOOP
-- ==================================
local function KillAuraLoop()
    for _, Alvo in ipairs(Players:GetPlayers()) do
        if not KillAura then break end
        if Alvo ~= player and Alvo.Character and Alvo.Character:FindFirstChild("Head") then
            ExecutarAtaque(Alvo)
            task.wait(0.15)
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.3)
        if KillAura then
            KillAuraLoop()
        end
    end
end)

-- ==================================
-- ⭕ SISTEMA CÍRCULO VISUAL DO KILL AURA
-- ==================================
local function AtualizarCirculoAura()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if not MostrarCirculoAura or not hrp then
        if CirculoAdornment then
            CirculoAdornment:Destroy()
            CirculoAdornment = nil
        end
        return
    end
    
    if not CirculoAdornment or not CirculoAdornment.Parent then
        CirculoAdornment = Instance.new("CylinderHandleAdornment")
        CirculoAdornment.Name = "KillAuraRangeVisual"
        CirculoAdornment.Color3 = Color3.fromRGB(255, 0, 0)
        CirculoAdornment.Transparency = 0.6
        CirculoAdornment.AlwaysOnTop = true
        CirculoAdornment.ZIndex = 5
        CirculoAdornment.CFrame = CFrame.Angles(math.rad(90), 0, 0)
    end
    
    CirculoAdornment.Adornee = hrp
    CirculoAdornment.Parent = hrp
    CirculoAdornment.Height = 0.2
    CirculoAdornment.Radius = RaioKillAura
end

task.spawn(function()
    while true do
        task.wait(0.1)
        AtualizarCirculoAura()
    end
end)

-- ==================================
-- 🧲 SISTEMA GRAB PLAYER
-- ==================================
local function TrancarJogadorNaFrente()
    if ConexaoGrabLocal then
        ConexaoGrabLocal:Disconnect()
        ConexaoGrabLocal = nil
    end
    if not JogadorSelecionado or JogadorSelecionado == "Nenhum Jogador" then return end
    
    local targetPlayer = Players:FindFirstChild(JogadorSelecionado)
    if not targetPlayer then return end
    
    local character = player.Character
    local targetChar = targetPlayer.Character
    if not character or not targetChar then return end
    
    local myHRP = character:FindFirstChild("HumanoidRootPart")
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    if not myHRP or not targetHRP then return end
    
    ConexaoGrabLocal = RunService.RenderStepped:Connect(function()
        if character and character:FindFirstChild("HumanoidRootPart") 
        and targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
            local posicaoFrente = myHRP.CFrame * CFrame.new(0, 0, -2.5) * CFrame.Angles(0, math.rad(180), 0)
            targetHRP.CFrame = posicaoFrente
        else
            if ConexaoGrabLocal then
                ConexaoGrabLocal:Disconnect()
                ConexaoGrabLocal = nil
            end
        end
    end)
end

local function SoltarJogador()
    if ConexaoGrabLocal then
        ConexaoGrabLocal:Disconnect()
        ConexaoGrabLocal = nil
    end
end

-- ==================================
-- 📋 SISTEMA LISTA DE JOGADORES
-- ==================================
local function PegarListaJogadores()
    local lista = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            table.insert(lista, p.Name)
        end
    end
    table.sort(lista)
    if #lista == 0 then
        table.insert(lista, "Nenhum Jogador")
    end
    return lista
end

local function AtualizarListaJogadores()
    local lista = PegarListaJogadores()
    pcall(function()
        if DropdownJogadores and DropdownJogadores.Refresh then
            DropdownJogadores:Refresh(lista)
        elseif DropdownJogadores and DropdownJogadores.SetValues then
            DropdownJogadores:SetValues(lista)
        end
    end)
end

Players.PlayerAdded:Connect(function()
    task.wait(0.3)
    AtualizarListaJogadores()
end)

Players.PlayerRemoving:Connect(function()
    task.wait(0.3)
    AtualizarListaJogadores()
end)

-- ==================================
-- 🗡️ SISTEMA BOTÃO FLUTUANTE KILL ALL
-- ==================================
local function CreateKillAllButton()
    if KillAllButtonGui then return end
    
    local ParentGui = CoreGui
    pcall(function()
        if not CoreGui then ParentGui = player:WaitForChild("PlayerGui") end
    end)
    
    local GuiBtn = Instance.new("ScreenGui")
    GuiBtn.Name = "AstralX_KillAllButton"
    GuiBtn.ResetOnSpawn = false
    GuiBtn.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    GuiBtn.Parent = ParentGui
    
    local Btn = Instance.new("ImageButton")
    Btn.Size = UDim2.new(0, 110, 0, 42)
    Btn.Position = UDim2.new(0.5, -55, 0.7, -21)
    Btn.BackgroundColor3 = Color3.fromRGB(150, 20, 20)
    Btn.BackgroundTransparency = 0.3
    Btn.Parent = GuiBtn
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 10)
    Corner.Parent = Btn
    
    local Borda = Instance.new("UIStroke")
    Borda.Color = Color3.fromRGB(255, 50, 50)
    Borda.Thickness = 2
    Borda.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Borda.Parent = Btn
    
    local Texto = Instance.new("TextLabel")
    Texto.Size = UDim2.new(1, 0, 1, 0)
    Texto.BackgroundTransparency = 1
    Texto.Text = "Kill All"
    Texto.TextColor3 = Color3.fromRGB(255, 255, 255)
    Texto.TextSize = 15
    Texto.Font = Enum.Font.GothamBold
    Texto.Parent = Btn
    
    Btn.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.Touch 
        or Input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDraggingKill = true
            buttonStartPosKill = Btn.Position
            dragStartPosKill = Input.Position
            Input.Changed:Connect(function()
                if Input.UserInputState == Enum.UserInputState.End then 
                    isDraggingKill = false 
                end
            end)
        end
    end)
    
    Btn.InputChanged:Connect(function(Input)
        if isDraggingKill and (Input.UserInputType == Enum.UserInputType.Touch 
        or Input.UserInputType == Enum.UserInputType.MouseMovement) then
            Btn.Position = buttonStartPosKill + UDim2.fromOffset(
                Input.Position.X - dragStartPosKill.X,
                Input.Position.Y - dragStartPosKill.Y
            )
        end
    end)
    
    Btn.MouseButton1Click:Connect(function() 
        if not isDraggingKill then 
            KillAllInstantaneo() 
        end 
    end)
    
    KillAllButtonGui = GuiBtn
end

local function RemoveKillAllButton()
    if KillAllButtonGui then 
        KillAllButtonGui:Destroy() 
        KillAllButtonGui = nil 
    end
end

