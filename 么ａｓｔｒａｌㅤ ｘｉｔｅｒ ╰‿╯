        SafePlatform.Size = Vector3.new(20, 2, 20)
        SafePlatform.Position = SafePosition
        SafePlatform.Anchored = true
        SafePlatform.Color = Color3.fromRGB(0, 0, 0)
        SafePlatform.Transparency = 0.5
        SafePlatform.Material = Enum.Material.SmoothPlastic
        SafePlatform.CanCollide = true
        SafePlatform.Parent = Workspace
    end

    -- Teleporta o jogador para cima da plataforma
    hrp.CFrame = CFrame.new(SafePosition + Vector3.new(0, 3, 0))
end

