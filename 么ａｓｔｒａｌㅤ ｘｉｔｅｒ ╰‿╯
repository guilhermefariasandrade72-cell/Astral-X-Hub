-- Função principal que executa o Fling em um alvo específico e depois retorna
local function ExecutarFlingAlvo(alvo)
    if ExecutandoFling or not alvo or not alvo.Character then return end
    
    local meuChar = player.Character
    local meuHRP = meuChar and meuChar:FindFirstChild("HumanoidRootPart")
    local meuHumanoid = meuChar and meuChar:FindFirstChildOfClass("Humanoid")
    local alvoHRP = alvo.Character:FindFirstChild("HumanoidRootPart")

    if not meuHRP or not meuHumanoid or not alvoHRP then return end

    ExecutandoFling = true

    -- 1. Salvar posição original
    local posOriginal = meuHRP.CFrame

    -- 2. Configurar o estado do personagem para girar sem cair
    meuHumanoid.PlatformStand = true

    -- Desativar colisões para não travar no alvo
    for _, part in ipairs(meuChar:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    -- 3. Loop de Fling por 2 segundos
    local tempoInicial = tick()
    local conexaoFling

    conexaoFling = RunService.Heartbeat:Connect(function()
        if tick() - tempoInicial >= 2 or not alvo.Character or not alvoHRP:IsDescendantOf(workspace) then
            conexaoFling:Disconnect()
            return
        end

        -- Teleporta para o centro do alvo deitado (girando CFrame)
        meuHRP.CFrame = alvoHRP.CFrame * CFrame.Angles(math.rad(90), math.rad(math.random(1, 360)), 0)
        
        -- Aplica velocidade angular extrema (1.000.000)
        meuHRP.AssemblyAngularVelocity = Vector3.new(0, 1000000, 0)
    end)

    task.wait(2)

    if conexaoFling then conexaoFling:Disconnect() end

    -- 4. Parar rotação e restaurar colisão/posição
    meuHRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    meuHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    
    task.wait(0.05)
    meuHRP.CFrame = posOriginal
    meuHumanoid.PlatformStand = false
    
    ExecutandoFling = false
end

-- Busca de Murderer e Sheriff pelos cargos
local function FlingPorCargo(cargoBusca)
    local DataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if not DataRemote then return end
    
    local ok, Data = pcall(function() return DataRemote:InvokeServer() end)
    if not ok or not Data then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local info = Data[p.Name]
            if info and not info.Killed and not info.Dead and info.Role == cargoBusca then
                ExecutarFlingAlvo(p)
                break
            end
        end
    end
end

