local Sec_Fling = Aba_Tele:Section({Title = "Fling Player"})

-- Atualiza dinamicamente o Dropdown para não manter jogadores offline
local function CriarDropdownFling()
    if DropdownFling then
        pcall(function() DropdownFling:Destroy() end)
    end
    
    DropdownFling = Sec_Fling:Dropdown({
        Title = "Lista de Jogadores",
        Values = PegarListaJogadoresFling(),
        Default = "",
        Callback = function(nome)
            JogadorSelecionadoFling = nome
        end
    })
end

-- Eventos para recriar a lista sempre que alguém entrar ou sair
Players.PlayerAdded:Connect(function() task.wait(0.3) CriarDropdownFling() end)
Players.PlayerRemoving:Connect(function() task.wait(0.3) CriarDropdownFling() end)

-- Inicializa a lista
CriarDropdownFling()

