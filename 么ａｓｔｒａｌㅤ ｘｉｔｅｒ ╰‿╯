local function CriarDropdownJogadores()
    if DropdownJogadores then
        pcall(function() DropdownJogadores:Destroy() end)
    end
    DropdownJogadores = Sec_Teleporte:Dropdown({
        Title = "Escolha um jogador",
        Values = PegarListaJogadores(),
        Default = "",
        Callback = function(nome)
            JogadorSelecionadoTP = nome
        end
    })
end

Players.PlayerAdded:Connect(function() task.wait(0.3) CriarDropdownJogadores() end)
Players.PlayerRemoving:Connect(function() task.wait(0.3) CriarDropdownJogadores() end)

