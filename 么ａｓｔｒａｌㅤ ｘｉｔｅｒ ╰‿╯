local function EmPartida()
    local c = player.Character
    if not c or not c:FindFirstChild("Humanoid") or c.Humanoid.Health <= 0 then return false end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            return true
        end
    end
    return false
end

local function QuantidadeMochila()
    local ok, n = pcall(function()
        local g = player.PlayerGui:WaitForChild("MainGUI", 2)
        return tonumber(g.Game.CoinBags.Container.SnowToken.CurrencyFrame.Icon.Coins.Text) or 0
    end)
    return ok and n or 0
end

local function getNearestCoin(minhaPos)
    local melhorMoeda, menorDistancia = nil, math.huge
    local CoinContainer = Workspace:FindFirstChild("CoinContainer", true)
    if not CoinContainer then return nil end

    for _, moeda in ipairs(CoinContainer:GetChildren()) do
        if moeda:IsA("BasePart") 
        and moeda.Name == "Coin_Server"
        and moeda:FindFirstChild("TouchInterest") 
        and moeda:FindFirstChild("CoinVisual")
        and not collectedCoins[moeda] 
        and not moeda:GetAttribute("Collected") then
            
            local distancia = (minhaPos - moeda.Position).Magnitude
            if distancia < CONFIG_FARM.alcance_maximo and distancia < menorDistancia then
                menorDistancia = distancia
                melhorMoeda = moeda
            end
        end
    end
    return melhorMoeda
end

-- 📌 LOOP PRINCIPAL CORRIGIDO COM RECALCULO EM TEMPO REAL
task.spawn(function()
    while true do
        if AutoFarmAtivo then
            if not EmPartida() then
                table.clear(collectedCoins)
                RunService.Heartbeat:Wait()
                continue
            end

            local atual = QuantidadeMochila()
            if atual >= CONFIG_FARM.limite then
                repeat
                    RunService.Heartbeat:Wait()
                    atual = QuantidadeMochila()
                until atual < CONFIG_FARM.limite or not AutoFarmAtivo or not EmPartida()
                table.clear(collectedCoins)
                continue
            end

            local c = player.Character
            if not c or not c.PrimaryPart then
                RunService.Heartbeat:Wait()
                continue
            end

            -- Busca o alvo inicial
            local alvo = getNearestCoin(c.PrimaryPart.Position)

            if alvo then
                -- Loop de movimentação contínua
                while AutoFarmAtivo and EmPartida() and alvo and alvo.Parent 
                and QuantidadeMochila() < CONFIG_FARM.limite 
                and not alvo:GetAttribute("Collected") 
                and not collectedCoins[alvo] do
                    
                    local minhaPosAtual = c.PrimaryPart.Position
                    
                    -- 🔄 CHECAGEM DINÂMICA: Verifica se surgiu alguma outra moeda MAIS PERTO da posição atual
                    local novaMoedaProxima = getNearestCoin(minhaPosAtual)
                    if novaMoedaProxima and novaMoedaProxima ~= alvo then
                        -- Troca de alvo imediatamente no meio do caminho!
                        alvo = novaMoedaProxima
                    end

                    -- Se a moeda atual foi deletada do workspace por outro player
                    if not alvo:IsDescendantOf(Workspace) or alvo:GetAttribute("Collected") then
                        break
                    end

                    local posAlvo = alvo.Position
                    local direcao = (posAlvo - minhaPosAtual)
                    local distancia = direcao.Magnitude

                    -- Se chegou na moeda
                    if distancia <= 1.5 then
                        collectedCoins[alvo] = true
                        break
                    end

                    -- Move em passos curtos frame a frame baseados na velocidade
                    local dt = RunService.Heartbeat:Wait()
                    local passo = math.min(CONFIG_FARM.velocidade * dt, distancia)
                    local novaPos = minhaPosAtual + (direcao.Unit * passo)

                    c:PivotTo(CFrame.new(novaPos))
                end
            else
                table.clear(collectedCoins)
                RunService.Heartbeat:Wait()
            end
        else
            RunService.Heartbeat:Wait()
        end
    end
end)

