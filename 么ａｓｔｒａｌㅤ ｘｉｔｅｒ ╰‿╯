local function PegarCargo(Jogador, Dados)
    if not Dados or not Dados[Jogador.Name] then return "Espectador" end
    local Info = Dados[Jogador.Name]
    if Info.Killed or Info.Dead then return "Espectador" end
    return Info.Role
end

local function PegarCor(Cargo)
    return CoresCargo[Cargo] or CoresCargo.Espectador
end

local function CriarESP(Jogador)
    local Gui = Instance.new("ScreenGui")
    Gui.Name = "ESP_"..Jogador.Name
    Gui.ResetOnSpawn = false
    Gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    Gui.Parent = CoreGui

    local Highlight = Instance.new("Highlight")
    Highlight.Name = "ESP_Highlight"
    Highlight.Adornee = Jogador.Character
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.OutlineTransparency = 0
    Highlight.Enabled = false
    Highlight.Parent = Gui

    local Nome = Instance.new("TextLabel")
    Nome.Name = "ESP_Nome"
    Nome.BackgroundTransparency = 1
    Nome.Font = Enum.Font.GothamBold
    Nome.TextSize = 14
    Nome.Text = Jogador.Name
    Nome.TextColor3 = Color3.fromRGB(255,255,255)
    Nome.TextStrokeTransparency = 0
    Nome.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    Nome.AnchorPoint = Vector2.new(0.5, 0.5)
    Nome.Parent = Gui

    local Distancia = Instance.new("TextLabel")
    Distancia.Name = "ESP_Distancia"
    Distancia.BackgroundTransparency = 1
    Distancia.Font = Enum.Font.Gotham
    Distancia.TextSize = 12
    Distancia.Text = "0m"
    Distancia.TextColor3 = Color3.fromRGB(255,255,255)
    Distancia.TextStrokeTransparency = 0
    Distancia.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    Distancia.AnchorPoint = Vector2.new(0.5, 0.5)
    Distancia.Parent = Gui

    local Linha = Instance.new("Frame")
    Linha.Name = "ESP_Linha"
    Linha.BackgroundTransparency = 0
    Linha.AnchorPoint = Vector2.new(0.5, 0)
    Linha.Size = UDim2.new(0, 2, 0, 150)
    Linha.Parent = Gui

    ESP_Objetos[Jogador] = {
        Gui = Gui,
        Highlight = Highlight,
        Nome = Nome,
        Distancia = Distancia,
        Linha = Linha
    }
end

local function RemoverESP(Jogador)
    if ESP_Objetos[Jogador] then
        ESP_Objetos[Jogador].Gui:Destroy()
        ESP_Objetos[Jogador] = nil
    end
end

-- 📌 LOOP PRINCIPAL
RunService.RenderStepped:Connect(function()
    local Cam = Workspace.CurrentCamera
    local DadosRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    local Dados = nil
    if DadosRemote then
        local ok, res = pcall(function() return DadosRemote:InvokeServer() end)
        if ok then Dados = res end
    end

    for _, Jogador in ipairs(Players:GetPlayers()) do
        if Jogador == player then continue end

        local Char = Jogador.Character
        if not Char or not Char:FindFirstChild("HumanoidRootPart") or not Char:FindFirstChild("Head") then
            RemoverESP(Jogador)
            continue
        end

        -- ✅ SE NÃO TIVER CARGO OU ESTIVER MORTO → ESPECTADOR (BRANCO)
        local Cargo = PegarCargo(Jogador, Dados)

        if not ESP_Objetos[Jogador] then
            CriarESP(Jogador)
        end

        local ESP = ESP_Objetos[Jogador]
        local Cor = PegarCor(Cargo)

        -- ✅ HIGHLIGHT
        ESP.Highlight.Enabled = ESP_Ativo.Highlight
        ESP.Highlight.FillColor = Cor
        ESP.Highlight.OutlineColor = Cor
        ESP.Highlight.Adornee = Char

        -- Posições na tela
        local PosCabeca, OnScreen = Cam:WorldToViewportPoint(Char.Head.Position)
        local PosPes = Cam:WorldToViewportPoint(Char.HumanoidRootPart.Position - Vector3.new(0, 2, 0))
        local TelaLargura, TelaAltura = Cam.ViewportSize.X, Cam.ViewportSize.Y

        -- ✅ NOME → EM CIMA DA CABEÇA
        ESP.Nome.Visible = ESP_Ativo.Nome and OnScreen
        if ESP.Nome.Visible then
            ESP.Nome.Position = UDim2.fromOffset(PosCabeca.X, PosCabeca.Y - 25)
            ESP.Nome.TextColor3 = Cor
            ESP.Nome.Text = Jogador.Name
        end

        -- ✅ DISTÂNCIA → EM BAIXO DOS PÉS
        local DistanciaValor = math.floor((Char.HumanoidRootPart.Position - Cam.CFrame.Position).Magnitude)
        ESP.Distancia.Visible = ESP_Ativo.Distancia and OnScreen
        if ESP.Distancia.Visible then
            ESP.Distancia.Position = UDim2.fromOffset(PosPes.X, PosPes.Y + 5)
            ESP.Distancia.TextColor3 = Cor
            ESP.Distancia.Text = DistanciaValor.."m"
        end

        -- ✅ LINHA → ATÉ O FUNDO DA TELA
        ESP.Linha.Visible = ESP_Ativo.Linha and OnScreen
        if ESP.Linha.Visible then
            local AlturaLinha = TelaAltura - PosCabeca.Y
            ESP.Linha.Size = UDim2.new(0, 2, 0, AlturaLinha)
            ESP.Linha.Position = UDim2.fromOffset(PosCabeca.X, PosCabeca.Y)
            ESP.Linha.BackgroundColor3 = Cor
        end
    end
end)


