-- 🟢 PULO INFINITO
UserInputService.JumpRequest:Connect(function()
    if _G.PuloInfinito then
        local Char = player.Character
        if Char and Char:FindFirstChild("Humanoid") then
            Char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- 🟢 LOOP PRINCIPAL (Velocidade no Pulo + Câmera Sem Bloqueio + FOV)
RunService.Stepped:Connect(function()
    local Char = player.Character
    if not Char or not Char:FindFirstChild("Humanoid") then return end
    local Hum = Char.Humanoid

    -- ✅ Velocidade no Pulo
    if _G.SpeedNoPulo then
        if Hum.FloorMaterial == Enum.Material.Air then
            Hum.WalkSpeed = VelocidadeNoPulo
        else
            Hum.WalkSpeed = VelocidadePadrao
        end
    end
end)

-- ✅ CÂMERA SEM BLOQUEIO E FOV (sem mexer no zoom!)
RunService.RenderStepped:Connect(function()
    local Cam = Workspace.CurrentCamera
    if not Cam then return end

    -- 👁️ Câmera Sem Bloqueio
    if _G.CameraNoClip then
        player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
    else
        player.DevCameraOcclusionMode = BloqueioOriginal
    end

    -- 🔧 Campo de Visão
    Cam.FieldOfView = FOV_Padrao
end)

