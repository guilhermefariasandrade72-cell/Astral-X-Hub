local function EstaDentroDoFOV(posicao3D)
    local camera = workspace.CurrentCamera
    if not camera then return false end
    
    local posTela, visivel = camera:WorldToViewportPoint(posicao3D)
    if not visivel then return false end

    local centroTela = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local posAlvo2D = Vector2.new(posTela.X, posTela.Y)
    
    local distanciaPixels = (posAlvo2D - centroTela).Magnitude
    return distanciaPixels <= (RaioFOV / 2)
end

