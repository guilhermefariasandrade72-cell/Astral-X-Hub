AplicarValoresBase()

player.CharacterAdded:Connect(function()
    task.wait(0.5)
    AplicarValoresBase()
    -- ✅ FORÇA ZOOM VOLTAR AO RENASCER
    task.wait(1)
    if not _G.CameraInfinita then
        player.CameraMaxZoomDistance = ZoomMaxOriginal
        player.CameraMinZoomDistance = ZoomMinOriginal
    end
end)

-- 🟢 PULO INFINITO
